{
  "id": "mnjoin",
  "rules" : {
    "k" : {
      "presence": {"allowEmpty": false},
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+$",
          "message" : "1項目のみ入力してください"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?$|^@\\[.+\\]$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "f" : {
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+$|^$",
          "message" : "1項目のみ入力してください"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?|^$|^@\\[.+\\]$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "bufcount" : {
      "specifiedFormatIfTargetInput" : {
        "target" : "bufcount",
        "pattern": "^[1-9]?[0-9]*$|^$",
        "message": "0以上の整数を半角で入力してください"
      }
    }
  },
  "params": [
    {
      "name": "k",
      "type": "string",
      "label": "入力データの結合キー名(必須)"
    },
    {
      "name": "f",
      "type": "string",
      "label": "参照列名",
      "optional": true
    },
    {
      "name": "K",
      "type": "string",
      "label": "参照データの結合キー名",
      "optional": true
    },
    {
      "name": "n",
      "type": "boolean",
      "label": "参照データにない入力データをNULL値として出力するフラグ。",
      "optional": true
    },
    {
      "name": "N",
      "type": "boolean",
      "label": "入力データにない参照データをNULL値として出力するフラグ。",
      "optional": true
    },
    {
      "name": "bufcount",
      "type": "string",
      "label": "バッファの数",
      "optional": true,
      "default": "10"
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目にNULL値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=またはvf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      },
      {
        "name": "m",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "参照ファイル列の結合",
  "classification": "table_join",
  "description": "入力ファイルの項目値と参照ファイルの項目値を比較、同値であれば参照ファイルにある、f=で指定した項目値を結合する。",
  "url": "./static/pdf/mcmd/table_join/mnjoin.pdf"
}