{
    "id": "mselstr",
    "params": [
        {
            "name": "f",
            "type": "string",
            "label": "対象列名"
        },
        {
            "name": "v",
            "type": "string",
            "label": "絞込条件値（文字列）"
        },
        {
            "name": "k",
            "type": "string",
            "label": "選択単位となるキー列名",
            "optional": true
        },
        {
            "name": "F",
            "type": "boolean",
            "label": "f= パラメータで複数項目を指定した場合、その全ての値がマッチする行を撰択する。",
            "optional": true
        },
        {
            "name": "r",
            "type": "boolean",
            "label": "選択ではなく削除する。",
            "optional": true
        },
        {
            "name": "R",
            "type": "boolean",
            "label": "k= パラメータを指定した場合、その全ての行がマッチすれば行を撰択する。",
            "optional": true
        },
        {
            "name": "sub",
            "type": "boolean",
            "label": "検索を完全一致ではなく部分文字列マッチで比較する。",
            "optional": true
        },
        {
            "name": "head",
            "type": "boolean",
            "label": "先頭文字列マッチオプション",
            "optional": true
        },
        {
            "name": "tail",
            "type": "boolean",
            "label": "末尾文字列マッチオプション",
            "optional": true
        },
        {
            "name": "W",
            "type": "boolean",
            "label": "sub,head,tail オプションが指定されているときにワイド文字として部分文字列マッチをおこなう。",
            "optional": true
        },
        {
            "name": "bufcount",
            "type": "string",
            "label": "バッファの数",
            "optional": true
        },
        {
            "name": "assert_diffSize",
            "type": "boolean",
            "label": "入力、出力件数比較を行う",
            "optional": true
        },
        {
            "name": "assert_nullkey",
            "type": "boolean",
            "label": "キー項目にNULL値が含まれているかどうかのチェックを行う",
            "optional": true
        },
        {
            "name": "assert_nullin",
            "type": "boolean",
            "label": "入力項目のf=またはvf=で指定された項目のNULL値チェックを行う",
            "optional": true
        },
        {
            "name": "nfn",
            "type": "boolean",
            "label": "入力データの1行目を項目名行とみなさない。",
            "optional": true
        },
        {
            "name": "nfno",
            "type": "boolean",
            "label": "出力データに項目名行を出力しない。",
            "optional": true
        },
        {
            "name": "x",
            "type": "boolean",
            "label": "項目番号による指定",
            "optional": true
        },
        {
            "name": "q",
            "type": "boolean",
            "label": "自動並べ替えの無効化",
            "optional": true
        },
        {
            "name": "tmpPath",
            "type": "string",
            "label": "作業ファイル格納パス名",
            "optional": true
        }
    ],
    "ports": [
        [
            {
                "name": "i",
                "type": "frame"
            }
        ],
        [
            {
                "name": "o",
                "type": "frame"
            },
            {
                "name": "u",
                "type": "frame"
            }
        ]
    ],
    "version": "0.7.0",
    "label": "行選択(文字列)",
    "classification": "row_edit",
