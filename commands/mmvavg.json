{
    "id": "mmvavg",
    "params": [
        {
            "name": "s",
            "type": "string",
            "label": "並べ替えの後、移動平均を計算する列名",
            "optional": true
        },
        {
            "name": "k",
            "type": "string",
            "label": "単位とする列名",
            "optional": true
        },
        {
            "name": "n",
            "type": "string",
            "label": "Null データの場合は NULL にするフラグ",
            "optional": true
        },
        {
            "name": "f",
            "type": "string",
            "label": "移動平均を求める列名(必須)"
        },
        {
            "name": "t",
            "type": "string",
            "label": "移動平均を求める項目名リスト (複数項目指定可) を指定する。",
            "optional": true
        },
        {
            "name": "exp",
            "type": "boolean",
            "label": "指数平滑移動平均を求める。",
            "optional": true
        },
        {
            "name": "w",
            "type": "boolean",
            "label": "線形加重移動平均を求める。",
            "optional": true
        },
        {
            "name": "alpha",
            "type": "string",
            "label": "-exp が指定された時の平滑化係数を実数値で与える。省略時は alpha=2/(t=の値 +1)。",
            "optional": true
        },
        {
            "name": "skip",
            "type": "string",
            "label": "出力を抑制する最初の行数。デフォルト値: skip=(t=の値-1), -exp が指定された場合は skip=0",
            "optional": true
        },
        {
            "name": "assert_diffSize",
            "type": "boolean",
            "label": "入力、出力件数比較を行う",
            "optional": true
        },
        {
            "name": "assert_nullkey",
            "type": "boolean",
            "label": "キー項目に NULL 値が含まれているかどうかのチェックを行う",
            "optional": true
        },
        {
            "name": "assert_nullin",
            "type": "boolean",
            "label": "入力項目の f=または vf=で指定された項目の NULL 値チェックを行う",
            "optional": true
        },
        {
            "name": "assert_nullout",
            "type": "boolean",
            "label": "出力項目の NULL 値チェックを行う",
            "optional": true
        },
        {
            "name": "nfn",
            "type": "boolean",
            "label": "入力データの 1 行目を項目名行とみなさない。",
            "optional": true
        },
        {
            "name": "nfno",
            "type": "boolean",
            "label": "出力データに項目名行を出力しない。",
            "optional": true
        },
        {
            "name": "x",
            "type": "boolean",
            "label": "項目番号による指定",
            "optional": true
        },
        {
            "name": "q",
            "type": "boolean",
            "label": "自動並べ替えの無効化",
            "optional": true
        },
        {
            "name": "tmpPath",
            "type": "string",
            "label": "作業ファイル格納パス名",
            "optional": true
        },
        {
            "name": "precision",
            "type": "string",
            "label": "有効桁数",
            "optional": true
        }
    ],
    "ports": [
