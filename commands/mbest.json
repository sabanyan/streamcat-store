{
    "id": "mbest",
    "params": [
        {
            "name": "s",
            "type": "string",
            "label": "ソート対象列名(必須)"
        },
        {
            "name": "from",
            "type": "string",
            "label": "選択する開始行番号",
            "optional": true
        },
        {
            "name": "to",
            "type": "string",
            "label": "選択する終了行番号",
            "optional": true
        },
        {
            "name": "size",
            "type": "string",
            "label": "選択する行数",
            "optional": true
        },
        {
            "name": "k",
            "type": "string",
