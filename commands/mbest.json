            "optional": true
        },
        {
            "name": "assert_diffSize",
            "type": "boolean",
            "label": "入力、出力件数比較を行う",
            "optional": true
        },
        {
            "name": "assert_nullkey",
            "type": "boolean",
            "label": "キー項目に NULL 値が含まれているかどうかのチェックを行う",
            "optional": true
        },
        {
