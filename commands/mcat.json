{
    "id": "mcat",
    "params": [
        {
            "name": "f",
            "type": "string",
            "label": "併合する項目名を指定する。",
            "optional": true
        },
        {
            "name": "skip_fnf",
            "type": "boolean",
            "label": "i=で指定したファイルが存在しなくてもエラー終了しない。",
            "optional": true
        },
        {
            "name": "nostop",
            "type": "boolean",
            "label": "指定の項目名がなければ null を出力する。-nfn が同時に指定された場合，項目数が異なればエラー終了する。",
            "optional": true
        },
        {
            "name": "skip",
            "type": "boolean",
            "label": "指定の項目名がなければそのファイルは併合しない。",
            "optional": true
        },
        {
            "name": "force",
            "type": "boolean",
            "label": "指定の項目名がなければ，項目番号で強制併合する",
            "optional": true
        },
        {
            "name": "stdin",
            "type": "boolean",
            "label": "標準入力も併合する。",
            "optional": true
        },
        {
            "name": "assert_diffSize",
            "type": "boolean",
            "label": "入力、出力件数比較を行う",
            "optional": true
        },
        {
            "name": "assert_nullin",
            "type": "boolean",
            "label": "入力項目の f=または vf=で指定された項目の NULL 値チェックを行う",
            "optional": true
        },
        {
            "name": "nfn",
            "type": "boolean",
            "label": "入力データの 1 行目を項目名行とみなさない。",
            "optional": true
        },
        {
            "name": "nfno",
            "type": "boolean",
            "label": "出力データに項目名行を出力しない。",
            "optional": true
        },
        {
            "name": "x",
            "type": "boolean",
            "label": "項目番号による指定",
            "optional": true
        },
        {
            "name": "q",
            "type": "boolean",
            "label": "自動並べ替えの無効化",
            "optional": true
        },
        {
            "name": "tmpPath",
            "type": "string",
            "label": "作業ファイル格納パス名",
            "optional": true
        }
    ],
    "ports": [
        [
            {
                "name": "*",
                "type": "frame"
            }
        ],
        [
            {
                "name": "o",
                "type": "frame"
            }
        ]
    ],
    "version": "0.7.0",
    "label": "ファイル結合",
    "classification": "table_join",
    "description": "./static/pdf/mcmd/table_join/mcat.pdf"
}