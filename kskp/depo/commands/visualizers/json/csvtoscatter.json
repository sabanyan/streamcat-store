{
  "version": "0.7.0",
  "id": "csvtoscatter",
  "order": 500,
  "label": "散布図",
  "classification": "visualize",
  "description": "csvファイルから散布図を作成する",
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "params": [
    {
      "name": "x_axis",
      "type": "list",
      "elements": [
        {
          "name"  :"column",
          "type"  :"column",
          "label" :"横軸列：時間軸"
        },
        {
          "name"  :"label",
          "type"  :"string",
          "label" :"横軸名"
        }
      ],
      "default":[{"column":null, "label":""}],
      "options":{
        "visiable_button_add"   : false,
        "visiable_button_delete": false,
        "draggable"             : false
      }
    },
    {
      "name": "y_axis",
      "type": "list",
      "elements": [
        {
          "name"  :"column",
          "type"  :"column",
          "label" :"縦軸列：データ"
        },
        {
          "name"  :"label",
          "type"  :"string",
          "label" :"縦軸名"
        }
      ],
      "default":[{"column":null, "label":""}],
      "options":{
        "visiable_button_add"   : false,
        "visiable_button_delete": false,
        "draggable"             : false
      }
    },
    {
      "name": "data_column",
      "type": "column",
      "options":{
        "multiple": true
      },
      "label": "データ系列",
      "default": []
    },
    {
      "name": "offset",
      "type": "number",
      "label": "表示の開始（１始まりの行番号）"
    },
    {
      "name": "limit",
      "type": "number",
      "label": "表示の件数",
      "default": 100
    },
    {
      "name": "withoutContourLine",
      "type": "boolean",
      "label": "等高線を表示しない",
      "optional": false
    },
    {
      "name": "width",
      "type": "number",
      "label": "横軸（ドット）",
      "default": 1000
    },
    {
      "name": "height",
      "type": "number",
      "label": "縦軸（ドット）",
      "default": 600
    }
  ],
  "groups": [
    {
      "name": "axis_group",
      "label": "軸の設定",
      "params": ["x_axis","y_axis"]
    },
    {
      "name": "data_group",
      "label": "データ系列の設定",
      "params": ["data_column"]
    },
    {
      "name": "offset_group",
      "label": "データ表示範囲の設定",
      "params": ["offset","limit"]
    },
    {
      "name": "graph_group",
      "label": "グラフ表示要素の設定",
      "params": ["withoutContourLine"]
    },
    {
      "name": "graph_size",
      "label": "グラフサイズの設定",
      "params": ["width","height"]
    }
  ],
  "url": ""
}
