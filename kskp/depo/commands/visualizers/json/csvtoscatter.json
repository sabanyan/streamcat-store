{
  "version": "0.7.0",
  "id": "csvtoscatter",
  "order": 500,
  "label": "散布図",
  "classification": "visualize",
  "description": "csvファイルから散布図を作成する",
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "params": [
    {
      "name": "data_column",
      "type": "column",
      "options":{
        "multiple": true
      },
      "label": "キー項目列名"
    },
    {
      "name": "x_axis",
      "type": "column",
      "options":{
        "multiple": false
      },
      "label": "x軸列"
    },
    {
      "name": "y_axis",
      "type": "column",
      "options":{
        "multiple": false
      },
      "label": "y軸列"
    },
    {
      "name": "b",
      "type": "boolean",
      "label": "等高線を表示しない",
      "optional": false
    },
    {
      "name": "offset",
      "type": "number",
      "label": "開始行"
    },
    {
      "name": "limit",
      "type": "number",
      "label": "行数",
      "default": 100
    },
    {
      "name": "x_size",
      "type": "number",
      "label": "ビジュアライズの横サイズ",
      "default": 1000
    },
    {
      "name": "y_size",
      "type": "number",
      "label": "ビジュアライズの縦サイズ",
      "default": 600
    },
    {
      "name": "x_label",
      "type": "string",
      "label": "x軸のラベル"
    },
    {
      "name": "y_label",
      "type": "string",
      "label": "y軸のラベル"
    }
  ],
  "url": ""
}
