{
  "id": "mvcount",
  "rules":{
    "vf":{
      "presence": {"allowEmpty": false},
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^:,]+:[^:,]+(,[^:,]+:[^:,]+)*$|^@\\[.+\\]$",
          "message" : "対象項目と、それに対応する新項目を:(コロン)を使用して入力してください。"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^[1-9]?[0-9]+L?:[^,:]+(,[1-9]?[0-9]+L?:[^,:]+)*$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    }
  },
  "params": [
    {
      "name": "vf",
      "type": "string",
      "label": "要素数をカウントするベクトルの列名"
    },
    {
      "name": "delim",
      "type": "string",
      "label": "ベクトル要素の区切り文字を指定",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=またはvf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "ベクトルサイズの計算",
  "classification": "col_edit",
  "description": "ベクトルのサイズ(ベクトルの要素数)を計算する。",
  "url": "./static/pdf/mcmd/col_edit/mvcount.pdf"
}