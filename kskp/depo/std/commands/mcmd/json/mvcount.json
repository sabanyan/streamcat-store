{
  "id": "mvcount",
  "rules": {
    "vf": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^:,]+:[^:,]+(,[^:,]+:[^:,]+)*$|^@\\[.+\\]$",
          "message": "対象項目と、それに対応する新項目を:(コロン)を使用して入力してください。"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^[1-9]?[0-9]+L?:[^,:]+(,[1-9]?[0-9]+L?:[^,:]+)*$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    }
  },
  "params": [
    {
      "name": "vf",
      "type": "string",
      "label": "要素数をカウントするベクトルの列名"
    },
    {
      "name": "delim",
      "type": "string",
      "label": "ベクトル要素の区切り文字",
      "optional": true,
      "description": "省略時は半角スペース"
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=またはvf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "ベクトルサイズの計算",
  "classification": "col_edit",
  "description": "ベクトルの要素数をカウントする",
  "url": "./static/pdf/mcmd/col_edit/mvcount.pdf",
  "groups": [
    {
      "name": "cmd_main",
      "label": "ベクトル併合の設定",
      "params": [
        "vf"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "delim",
        "nfn"
      ]
    },
    {
      "name": "fields",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullin",
        "tmpPath"
      ]
    }
  ]
}