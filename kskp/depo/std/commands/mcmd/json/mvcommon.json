{
  "id": "mvcommon",
  "rules": {
    "vf": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^:,]+(:[^:,]+)?(,[^:,]+(:[^:,]+)?)*$",
          "message": "入力値が正しくありません。"
        },
        "specialRules": [
          {
            "target": "A",
            "pattern": "^[^:,]+:[^:,]+(,[^:,]+:[^:,]+)*$|^@\\[.+\\]$",
            "message": "対象となる列名と新しい列名を、:(コロン)で区切って入力してください"
          },
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^[1-9]?[0-9]+L?(:[^,:]+)?(,[1-9]?[0-9]+L?(:[^,:]+)?)*$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "K": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$",
          "message": "入力が正しくありません"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    }
  },
  "params": [
    {
      "name": "vf",
      "type": "string",
      "label": "入力i の対象ベクトル項目名 (必須)",
      "description": "・カンマ区切りで複数指定可\n・ワイルドカード(*,？ )使用可"
    },
    {
      "name": "A",
      "type": "boolean",
      "label": "置換ではなく、項目を追加して出力する",
      "optional": true,
      "description": "追加する項目名は、対象ベクトル項目名の後に、コロン区切りで入力する"
    },
    {
      "name": "K",
      "type": "string",
      "label": "入力m の要素キー項目名 (必須)",
      "description": "・項目名を1つ指定する"
    },
    {
      "name": "r",
      "type": "boolean",
      "label": "条件反転　",
      "optional": true,
      "description": "入力m に存在しない要素だけを出力します"
    },
    {
      "name": "delim",
      "type": "string",
      "label": "ベクトル要素の区切り文字",
      "optional": true,
      "description": "省略時は半角スペース"
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力i の対象ベクトル項目名で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true,
      "description": "入力i と入力m ともにキー項目でソート済みの場合、指定すると処理速度が向上"
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      },
      {
        "name": "m",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "ベクトル要素の参照選択",
  "classification": "table_join",
  "description": "ベクトルから、参照データで指定された要素を選択する",
  "url": "./static/pdf/mcmd/table_join/mvcommon.pdf",
  "groups": [
    {
      "name": "key",
      "label": "参照キーの設定 (必須)",
      "params": [
        "vf",
        "A",
        "K",
        "delim",
        "r"
      ]
    },
    {
      "name": "merge_sub",
      "label": "その他 (省略可)",
      "params": [
        "q",
        "nfn",
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullin",
        "assert_nullout",
        "tmpPath"
      ]
    }
  ]
}