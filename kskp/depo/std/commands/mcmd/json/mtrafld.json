{
  "id": "mtrafld",
  "rules": {
    "f": {
      "presencesIfTargetIsInput": "r",
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^:,]+(:[^:,]+)?(,[^:,]+(:[^:,]+)?)*$|^$",
          "message": "対象の項目名と新項目名を、:(コロン)で区切って入力してください"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^[1-9]?[0-9]+L?(:[^,:]+)?(,[1-9]?[0-9]+L?(:[^,:]+)?)*$|^$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "a": {
      "presence": {
        "allowEmpty": false
      },
      "format": {
        "pattern": "^[^,]+$",
        "message": "項目名は一つのみ入力してください。"
      }
    }
  },
  "params": [
    {
      "name": "a",
      "type": "string",
      "label": "追加する項目名(必須)"
    },
    {
      "name": "f",
      "type": "string",
      "label": "対象とする項目名 (必須)",
      "optional": true,
      "description": "●カンマ区切りで複数指定可\n●ワイルドカード(*,？ )使用可"
    },
    {
      "name": "delim",
      "type": "string",
      "label": "ベクトル要素の区切り文字",
      "optional": true,
      "default": "",
      "description": "省略時は半角スペース"
    },
    {
      "name": "delim2",
      "type": "string",
      "label": "元の項目名と値の区切り文字",
      "optional": true,
      "default": "="
    },
    {
      "name": "r",
      "type": "boolean",
      "label": "変換時とは逆に、ベクトル要素を列に展開する",
      "optional": true
    },
    {
      "name": "valOnly",
      "type": "boolean",
      "label": "元の項目名を、ベクトル要素の一部として使用しない",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "キー項目にNULL値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "対象とする項目名のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "クロス表をトランザクション項目に変換(Mtrafld)",
  "classification": "value_crossing",
  "description": "複数項目の値を要素とするベクトル項目を作成する",
  "url": "./static/pdf/mcmd/value_crossing/mtrafld.pdf",
  "groups": [
    {
      "name": "cmd_main",
      "label": "データ変換の設定",
      "params": [
        "a",
        "delim",
        "f",
        "delim2",
        "valOnly",
        "r"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "nfn",
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullin",
        "assert_nullout",
        "tmpPath"
      ]
    }
  ]
}