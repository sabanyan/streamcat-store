{
  "id": "mmvavg",
  "rules": {
    "t": {
      "specifiedFormatIfTargetInput": {
        "target": "t",
        "pattern": "^[1-9]?[0-9]*$|^@\\[.+\\]$",
        "message": "1以上の整数を半角で入力してください"
      },
      "raiseWarningTargetsSelected": [
        "exp",
        "alpha"
      ]
    },
    "alpha": {
      "specifiedFormatIfTargetInput": {
        "target": "alpha",
        "pattern": "^(\\+|-)?[1-9]?[0-9]*(\\.[0-9]+)?$|^@\\[.+\\]$",
        "message": "実数を半角で入力してください"
      }
    },
    "skip": {
      "specifiedFormatIfTargetInput": {
        "target": "skip",
        "pattern": "^(\\+|-)?[1-9]?[0-9]*$|^@\\[.+\\]$",
        "message": "整数を半角で入力してください"
      }
    },
    "s": {
      "presencesIfTargetIsNotInput": "q",
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$|^$",
          "message": "入力が正しくありません"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$",
          "message": "入力が正しくありません"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "exp": {
      "presencesIfTargetIsInput": "alpha",
      "onlyOneInput": {
        "target": [
          "w"
        ]
      }
    },
    "w": {
      "onlyOneInput": {
        "target": [
          "exp"
        ]
      }
    }
  },
  "params": [
    {
      "name": "s",
      "type": "string",
      "label": "並べ替えの後、移動平均を計算する列名",
      "optional": true
    },
    {
      "name": "k",
      "type": "string",
      "label": "単位とする列名",
      "optional": true
    },
    {
      "name": "n",
      "type": "string",
      "label": "Null データの場合は NULL にするフラグ",
      "optional": true
    },
    {
      "name": "f",
      "type": "string",
      "label": "移動平均を求める列名(複数項目指定可, 必須)"
    },
    {
      "name": "t",
      "type": "string",
      "label": "移動平均を求める項目名リスト (複数項目指定可) を指定する。",
      "optional": true
    },
    {
      "name": "exp",
      "type": "boolean",
      "label": "指数平滑移動平均を求める。",
      "optional": true
    },
    {
      "name": "w",
      "type": "boolean",
      "label": "線形加重移動平均を求める。",
      "optional": true
    },
    {
      "name": "alpha",
      "type": "string",
      "label": "-exp が指定された時の平滑化係数を実数値で与える。省略時は alpha=2/(t=の値 +1)。",
      "optional": true
    },
    {
      "name": "skip",
      "type": "string",
      "label": "出力を抑制する最初の行数。デフォルト値: skip=(t=の値-1), -exp が指定された場合は skip=0",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目に NULL 値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目の f=または vf=で指定された項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "移動平均の計算",
  "classification": "table_grouping",
  "description": "移動平均（単純、線形加重、指数平滑）を算出する",
  "url": "./static/pdf/mcmd/table_grouping/mmvavg.pdf",
  "groups": [
    {
      "name": "grouping",
      "label": "グループの設定",
      "params": [
        "k"
      ]
    },
    {
      "name": "sorting",
      "label": "グループ内のソートの設定",
      "params": [
        "s"
      ]
    },
    {
      "name": "cmd_main",
      "label": "〇〇の設定",
      "params": [
        "f",
        "t",
        "skip"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "n",
        "exp",
        "w",
        "alpha",
        "nfn",
        "q"
      ]
    },
    {
      "name": "fields",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullkey",
        "assert_nullin",
        "assert_nullout",
        "tmpPath"
      ]
    }
  ]
}