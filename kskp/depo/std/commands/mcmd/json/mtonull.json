{
  "id": "mtonull",
  "rules": {
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$",
          "message": "入力が正しくありません"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "v": {
      "presence": {
        "allowEmpty": false
      },
      "format": {
        "pattern": "^[^:,]+(,[^:,]+)*$",
        "message": "入力が正しくありません。"
      }
    }
  },
  "params": [
    {
      "name": "f",
      "type": "string",
      "label": "対象とする項目名 (必須)",
      "description": "・カンマ区切りで複数指定可\n・ワイルドカード(*,？ )使用可"
    },
    {
      "name": "v",
      "type": "string",
      "label": "NULLで置換する値 (必須)",
      "description": "カンマ区切りで複数指定可"
    },
    {
      "name": "sub",
      "type": "boolean",
      "label": "全体ではなく、部分一致で置換する",
      "optional": true,
      "description": "一致部分ではなく、値全体がNULLで置換されます"
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "対象とする項目名で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true,
      "description": "入力データがグループ単位でソート済みの場合、指定すると処理速度が向上"
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "NULL値へ置換",
  "classification": "value_transform",
  "description": "指定した値にマッチした項目データをNULLに置換する",
  "url": "./static/pdf/mcmd/value_transform/mtonull.pdf",
  "groups": [
    {
      "name": "cmd_main",
      "label": "置換の設定 (必須)",
      "params": [
        "f",
        "v",
        "sub"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "q",
        "nfn",
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullin",
        "tmpPath"
      ]
    }
  ]
}