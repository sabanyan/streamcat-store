{
  "id": "mtonull",
  "rules" : {
    "f" : {
      "presence": {"allowEmpty": false},
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+(,[^,]+)*$",
          "message" : "入力が正しくありません"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "v" : {
      "presence": {"allowEmpty": false},
      "format" : {
        "pattern" : "^[^:,]+(,[^:,]+)*$",
        "message" : "入力が正しくありません。"
      }
    }
  },
  "params": [
    {
      "name": "f",
      "type": "string",
      "label": "対象列名(必須)"
    },
    {
      "name": "v",
      "type": "string",
      "label": "変換前文字列(必須)"
    },
    {
      "name": "sub",
      "type": "boolean",
      "label": "検索を完全一致ではなく部分文字列マッチで比較",
      "optional": true
    },
    {
      "name": "W",
      "type": "boolean",
      "label": "-sub オプションが指定されているときにワイド文字として部分文字列マッチをおこなう。",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=またはvf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "NULL値へ置換",
  "classification": "value_transform",
  "description": "f=で指定した項目を対象に、v=で指定した値にマッチした項目データをNULL値に変換する。",
  "url": "./static/pdf/mcmd/value_transform/mtonull.pdf"
}