{
  "id": "mnumber",
  "rules": {
    "s": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(%n|%r|%nr)?(,[^,]+(%n|%r|%nr)?)*$",
          "message": "入力値が正しくありません。"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(%n|%r|%nr)?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(%n|%r|%nr)?)*$|^@\\[.+\\](%n|%r|%nr)?$",
            "message": "項目の指定は数値のみ可能です。"
          },
          {
            "target": [
              "B"
            ],
            "pattern": "^[^,]+(%n|%r|%nr)?(,[^,]+(%n|%r|%nr)?)*$|^$",
            "message": "入力が正しくありません。"
          }
        ]
      },
      "presencesIfSpecifiedValueInput": {
        "target": "e",
        "value": [
          "same",
          "skip"
        ],
        "needOrNot": "1"
      },
      "presencesIfTargetIsNotInput": "B"
    },
    "I": {
      "format": {
        "pattern": "^[1-9]?[0-9]*$|^0$|^@\\[.+\\]$|^$",
        "message": "0以上の整数を半角で入力してください"
      }
    },
    "a": {
      "presencesIfTargetIsNotInput": [
        "nfn",
        "nfno"
      ],
      "specifiedFormatIfTargetInput": {
        "target": "a",
        "pattern": "^[^,]+$|^$",
        "message": "入力が正しくありません。"
      }
    }
  },
  "params": [
    {
      "name": "a",
      "type": "string",
      "label": "追加列名"
    },
    {
      "name": "e",
      "type": "string",
      "label": "同一キー同一ソート項目値への処理方法を指定する。",
      "optional": true,
      "default": "seq"
    },
    {
      "name": "I",
      "type": "string",
      "label": "連番の間隔を指定する。",
      "optional": true
    },
    {
      "name": "k",
      "type": "string",
      "label": "項目名リスト",
      "optional": true
    },
    {
      "name": "s",
      "type": "string",
      "label": "ソート対象列名",
      "optional": true
    },
    {
      "name": "S",
      "type": "string",
      "label": "開始No",
      "optional": true
    },
    {
      "name": "B",
      "type": "boolean",
      "label": "キー毎に連番もしくはアルファベット連番をふる。",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目にNULL値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "連番の付与",
  "classification": "col_edit",
  "description": "数字、英字の連番を付与する",
  "url": "./static/pdf/mcmd/col_edit/mnumber.pdf",
  "groups": [
    {
      "name": "grouping",
      "label": "グループの設定",
      "params": [
        "k"
      ]
    },
    {
      "name": "sorting",
      "label": "グループ内のソートの設定",
      "params": [
        "s",
        "S"
      ]
    },
    {
      "name": "cmd_main",
      "label": "列追加の設定",
      "params": [
        "a",
        "I"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "e",
        "B",
        "nfn",
        "q"
      ]
    },
    {
      "name": "fields",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullkey",
        "tmpPath"
      ]
    }
  ]
}