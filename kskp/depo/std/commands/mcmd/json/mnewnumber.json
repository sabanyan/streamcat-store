{
  "id": "mnewnumber",
  "rules": {
    "I": {
      "format": {
        "pattern": "^[1-9]?[0-9]*$|^@\\[.+\\]$|^$",
        "message": "1以上の整数を半角で入力してください"
      }
    },
    "S": {
      "format": {
        "pattern": "^[A-Z]$|^[1-9]?[0-9]*$|^@\\[.+\\]$|^$",
        "message": "半角の大文字アルファベットもしくは0以上の整数を半角で入力してください"
      }
    },
    "a": {
      "presence": {
        "allowEmpty": false
      }
    },
    "l": {
      "format": {
        "pattern": "^[1-9]?[0-9]*$|^@\\[.+\\]$|^$",
        "message": "1以上の整数を半角で入力してください"
      }
    }
  },
  "params": [
    {
      "name": "a",
      "type": "string",
      "label": "新規作成する連番行の項目名(必須)"
    },
    {
      "name": "I",
      "type": "string",
      "label": "連番を振る間隔",
      "optional": true,
      "default": "1"
    },
    {
      "name": "S",
      "type": "string",
      "label": "開始数値/アルファベット(大文字)",
      "optional": true,
      "default": "1"
    },
    {
      "name": "l",
      "type": "string",
      "label": "作成するデータ行数",
      "optional": true,
      "default": "10"
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "連番データの新規生成",
  "classification": "data_source",
  "description": "数値、英字の連番で、指定した行数を作成する",
  "url": "",
  "groups": [
    {
      "name": "sorting",
      "label": "グループ内のソートの設定",
      "params": [
        "S"
      ]
    },
    {
      "name": "cmd_main",
      "label": "〇〇の設定",
      "params": [
        "a",
        "I",
        "l"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "nfn"
      ]
    },
    {
      "name": "fields",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "tmpPath"
      ]
    }
  ]
}