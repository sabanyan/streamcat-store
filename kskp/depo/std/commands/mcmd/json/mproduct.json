{
  "id": "mproduct",
  "rules": {
    "f": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$|^$",
          "message": "入力値が正しくありません。"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "bufcount": {
      "specifiedFormatIfTargetInput": {
        "target": "bufcount",
        "pattern": "^[1-9]?[0-9]*$|^0$|^$",
        "message": "0以上の整数を半角で入力してください"
      }
    }
  },
  "params": [
    {
      "name": "f",
      "type": "string",
      "label": "参照データの結合列名",
      "optional": true
    },
    {
      "name": "bufcount",
      "type": "string",
      "label": "バッファの数",
      "optional": true,
      "default": 10
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=またはvf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      },
      {
        "name": "m",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "参照データの直積結合",
  "classification": "table_join",
  "description": "入力データ1行に対し、m=で指定した参照データのf=で指定した項目全行を結合する。",
  "url": "./static/pdf/mcmd/table_join/mproduct.pdf"
}