{
  "id": "mbest",
  "params": [
    {
      "name": "s",
      "type": "string",
      "label": "グループ内順序の指定"
    },
    {
      "name": "from",
      "type": "string",
      "label": "開始行番号(必須)",
      "optional": true,
      "default": "0"
    },
    {
      "name": "to",
      "type": "string",
      "label": "終了行番号",
      "optional": true
    },
    {
      "name": "size",
      "type": "string",
      "label": "開始行からの行数",
      "optional": true,
      "default": "1"
    },
    {
      "name": "k",
      "type": "string",
      "label": "グループ化する項目名",
      "optional": true
    },
    {
      "name": "r",
      "type": "boolean",
      "label": "条件にマッチしなかった行を選択する",
      "optional": true
    },
    {
      "name": "R",
      "type": "string",
      "label": "行番号リスト (複数項目指定可)",
      "optional": true,
      "description": "●カンマ区切りで複数指定可\n●範囲の複数指定も可能\n   方法: 開始と終了の行番号を _ 区切りで指定する"
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目に NULL 値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      },
      {
        "name": "u",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "指定行の選択",
  "classification": "row_edit",
  "description": "ランキングによる抽出を行う",
  "url": "./static/pdf/mcmd/row_edit/mbest.pdf",
  "groups": [
    {
      "name": "grouping",
      "label": "グループの設定",
      "params": [
        "k"
      ]
    },
    {
      "name": "sorting",
      "label": "グループ内のソートの設定",
      "params": [
        "s"
      ]
    },
    {
      "name": "cmd_main",
      "label": "行番号による選択の設定",
      "description": "行番号の範囲、およびリストによる指定が可能\n行番号は、0始まりの整数で指定する",
      "params": []
    },
    {
      "name": "cmd_main1",
      "label": "範囲で選択",
      "description": "(必須)開始行番号\n終了条件は、終了行番号か、開始行からの行数で指定する",
      "params": [
        "from",
        "to",
        "size"
      ]
    },
    {
      "name": "cmd_main2",
      "label": "リストで選択",
      "params": [
        "R"
      ]
    },
    {
      "name": "cmd_main3",
      "label": "条件反転",
      "params": [
        "r"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "nfn",
        "q"
      ]
    },
    {
      "name": "fields",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullkey",
        "tmpPath"
      ]
    }
  ]
}