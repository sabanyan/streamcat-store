{
  "id": "mvjoin",
  "groups": [
    {
      "name": "abstract",
      "label": "ベクトル要素の参照結合",
      "description": "・入力i の対象ベクトルの要素と、入力m の要素キーを照合して、対応する追加要素からベクトルを生成する\n・生成するベクトルは、対象ベクトルと結合して出力される",
      "params": []
    },
    {
      "name": "group5",
      "label": "結合キーの設定 (必須)",
      "params": [
        "vf",
        "A",
        "K",
        "delim"
      ]
    },
    {
      "name": "group6",
      "label": "追加要素の設定 (必須)",
      "params": [
        "f",
        "n"
      ]
    },
    {
      "name": "group10",
      "label": "その他 (省略可)",
      "params": [
        "nfn",
        "nfno",
        "x",
        "q"
      ]
    },
    {
      "name": "group20",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "tmpPath",
        "assert_nullin",
        "assert_nullout"
      ]
    }
  ],
  "rules": {
    "vf": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^:,]+(:[^:,]+)?(,[^:,]+(:[^:,]+)?)*$",
          "message": "入力値が正しくありません。"
        },
        "specialRules": [
          {
            "target": "A",
            "pattern": "^[^:,]+:[^:,]+(,[^:,]+:[^:,]+)*$|^@\\[.+\\]$",
            "message": "対象となる列名と新しい列名を、:(コロン)で区切って入力してください"
          },
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^[1-9]?[0-9]+L?(:[^,:]+)?(,[1-9]?[0-9]+L?(:[^,:]+)?)*$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "K": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$",
          "message": "入力が正しくありません"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$",
          "message": "入力が正しくありません"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    }
  },
  "params": [
    {
      "name": "vf",
      "type": "string",
      "label": "入力i の対象ベクトル項目名 (必須)",
      "description": "・カンマ区切りで複数指定可\n・ワイルドカード(*,？ )使用可"
    },
    {
      "name": "K",
      "type": "string",
      "label": "入力m の要素キー項目名 (必須)",
      "description": "・項目名を1つ指定する"
    },
    {
      "name": "f",
      "type": "string",
      "label": "入力m の追加要素の項目名 (必須)",
      "description": "・項目名を1つ指定する"
    },
    {
      "name": "A",
      "type": "boolean",
      "label": "置換ではなく、項目を追加して出力する",
      "optional": true,
      "description": "追加する項目名は、対象ベクトル項目名の後に、コロン区切りで入力する"
    },
    {
      "name": "n",
      "type": "string",
      "label": "入力m にない要素に対応する追加要素 (省略可)",
      "optional": true,
      "description": "省略時は、マッチしない値はNULLで置換される"
    },
    {
      "name": "delim",
      "type": "string",
      "label": "ベクトル要素の区切り文字　(省略可)",
      "optional": true,
      "description": "省略時は半角スペース"
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "2",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true,
      "description": "入力i と入力m ともにキー項目でソート済みの場合、指定すると処理速度が向上"
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      },
      {
        "name": "m",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "ベクトル要素の参照結合",
  "classification": "table_join",
  "description": "ベクトル要素をキーにして参照データのベクトル型データを結合",
  "url": "./static/pdf/mcmd/table_join/mvjoin.pdf"
}