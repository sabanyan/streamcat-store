{
  "id": "mvjoin",
  "groups": [
    {
      "name": "group5",
      "label": "結合キーの設定 (必須)",
      "params": [
        "vf",
        "K",
        "f",
        "A",
        "n",
        "delim"
      ]
    },
    {
      "name": "group10",
      "label": "その他 (省略可)",
      "params": [
        "q"
      ]
    },
    {
      "name": "group15",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "x",
        "nfn",
        "nfno"
      ]
    },
    {
      "name": "group20",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "tmpPath",
        "assert_diffSize",
        "assert_nullout",
        "assert_nullin"
      ]
    }
  ],
  "rules": {
    "vf": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^:,]+(:[^:,]+)?(,[^:,]+(:[^:,]+)?)*$",
          "message": "入力値が正しくありません。"
        },
        "specialRules": [
          {
            "target": "A",
            "pattern": "^[^:,]+:[^:,]+(,[^:,]+:[^:,]+)*$|^@\\[.+\\]$",
            "message": "対象となる列名と新しい列名を、:(コロン)で区切って入力してください"
          },
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^[1-9]?[0-9]+L?(:[^,:]+)?(,[1-9]?[0-9]+L?(:[^,:]+)?)*$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "K": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$",
          "message": "入力が正しくありません"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$",
          "message": "入力が正しくありません"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    }
  },
  "params": [
    {
      "name": "vf",
      "type": "string",
      "label": "入力 i のキー項目名",
      "description": "ベクトルの項目名を指定する\nカンマ区切りで複数指定可\n項目名のあとに、:区切りで新項目名を書くと、項目名を変更して出力される"
    },
    {
      "name": "K",
      "type": "string",
      "label": "入力 m の結合キーの項目名",
      "description": "ベクトル要素の項目名を1つ指定する"
    },
    {
      "name": "f",
      "type": "string",
      "label": "結合ベクトル列名(必須)"
    },
    {
      "name": "A",
      "type": "boolean",
      "label": "vf=で:(コロン) に続けて指定した項目名で、新たな項目が追加される。",
      "optional": true
    },
    {
      "name": "n",
      "type": "string",
      "label": "vf=とk=がマッチしなかった場合に結合する文字列",
      "optional": true
    },
    {
      "name": "delim",
      "type": "string",
      "label": "ベクトル要素の区切り文字",
      "optional": true,
      "description": "省略時は半角スペース"
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=またはvf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true,
      "description": "入力i と入力m ともにキー項目でソート済みの場合、指定すると処理速度が向上"
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      },
      {
        "name": "m",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "ベクトル要素の参照結合",
  "classification": "table_join",
  "description": "ベクトル要素をキーにして参照データのベクトル型データを結合",
  "url": "./static/pdf/mcmd/table_join/mvjoin.pdf"
}