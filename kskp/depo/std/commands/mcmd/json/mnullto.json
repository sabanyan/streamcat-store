{
  "id": "mnullto",
  "rules": {
    "v": {
      "onlyOneInput": {
        "target": [
          "p"
        ]
      },
      "presencesIfTargetIsNotInput": "p",
      "format": {
        "pattern": "^[^,]*$|^$",
        "message": "入力が正しくありません。"
      }
    },
    "p": {
      "onlyOneInput": {
        "target": [
          "v"
        ]
      },
      "presencesIfTargetIsNotInput": "v"
    },
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$",
          "message": "入力が正しくありません。"
        },
        "specialRules": [
          {
            "target": "A",
            "pattern": "^[^:,]+:[^:,]+(,[^:,]+:[^:,]+)*$|^@\\[.+\\]$",
            "message": "対象となる列名と新しい列名を、:(コロン)で区切って入力してください"
          },
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^[1-9]?[0-9]+L?(:[^,:]+)?(,[1-9]?[0-9]+L?(:[^,:]+)?)*$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "k": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "",
          "message": "[前の行のNULL値で置換する。v=パラメータと同時に指定できない]が選択されていないため、入力が無効です"
        },
        "specialRules": [
          {
            "target": "p",
            "pattern": "^[^,]+(,[^,]+)*$|^$",
            "message": "対象となる列名を入力してください"
          },
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "s": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^$",
          "message": "[前の行のNULL値で置換する。v=パラメータと同時に指定できない]が選択されていないため、入力が無効です。"
        },
        "specialRules": [
          {
            "target": "p",
            "pattern": "^[^,]*(,[^,]+)*$|^$",
            "message": "入力が正しくありません"
          }
        ]
      }
    }
  },
  "params": [
    {
      "name": "f",
      "type": "string",
      "label": "対象列名(必須)"
    },
    {
      "name": "v",
      "type": "string",
      "label": "変換後文字列",
      "optional": true
    },
    {
      "name": "p",
      "type": "boolean",
      "label": "前の行の NULL 値で置換する。v=パラメータと同時に指定できない",
      "optional": true
    },
    {
      "name": "s",
      "type": "string",
      "label": "[前の行のNULL値で置換する。v=パラメータと同時に指定できない]指定時のみ有効。k=項目内での並び順を指定する",
      "optional": true
    },
    {
      "name": "k",
      "type": "string",
      "label": "[前の行のNULL値で置換する。v=パラメータと同時に指定できない]指定時のみ有効。k=で指定した項目値の単位で置換処理を行う"
    },
    {
      "name": "O",
      "type": "string",
      "label": "NULL値以外を置換する文字列",
      "optional": true
    },
    {
      "name": "A",
      "type": "boolean",
      "label": "指定した項目を置き換えるのではなく、新たに項目が追加される。",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "NULL値の置換",
  "classification": "value_transform",
  "description": "NULL値を指定した文字列に置換する",
  "url": "./static/pdf/mcmd/value_transform/mnullto.pdf"
}