{
  "id": "mnullto",
  "rules": {
    "v": {
      "onlyOneInput": {
        "target": [
          "p"
        ]
      },
      "presencesIfTargetIsNotInput": "p",
      "format": {
        "pattern": "^[^,]*$|^$",
        "message": "入力が正しくありません。"
      }
    },
    "p": {
      "onlyOneInput": {
        "target": [
          "v"
        ]
      },
      "presencesIfTargetIsNotInput": "v"
    },
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$",
          "message": "入力が正しくありません。"
        },
        "specialRules": [
          {
            "target": "A",
            "pattern": "^[^:,]+:[^:,]+(,[^:,]+:[^:,]+)*$|^@\\[.+\\]$",
            "message": "対象となる列名と新しい列名を、:(コロン)で区切って入力してください"
          },
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^[1-9]?[0-9]+L?(:[^,:]+)?(,[1-9]?[0-9]+L?(:[^,:]+)?)*$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "k": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "",
          "message": "[前の行のNULL値で置換する。v=パラメータと同時に指定できない]が選択されていないため、入力が無効です"
        },
        "specialRules": [
          {
            "target": "p",
            "pattern": "^[^,]+(,[^,]+)*$|^$",
            "message": "対象となる列名を入力してください"
          },
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "s": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^$",
          "message": "[前の行のNULL値で置換する。v=パラメータと同時に指定できない]が選択されていないため、入力が無効です。"
        },
        "specialRules": [
          {
            "target": "p",
            "pattern": "^[^,]*(,[^,]+)*$|^$",
            "message": "入力が正しくありません"
          }
        ]
      }
    }
  },
  "params": [
    {
      "name": "f",
      "type": "string",
      "label": "対象列名(必須)",
      "description": "●カンマ区切りで複数指定可\n  項目名時: *,?  使用可\n● 新項目追加時\n 対象列名、追加列名の順で コロン区切りで指定する (例 元列名:追加列名)"
    },
    {
      "name": "v",
      "type": "string",
      "label": "変換後文字列",
      "optional": true
    },
    {
      "name": "p",
      "type": "boolean",
      "label": "NULLを前の行の値で置換する",
      "optional": true,
      "description": "変換後文字列と同時には指定できない"
    },
    {
      "name": "s",
      "type": "string",
      "label": "グループ内ソートの設定",
      "optional": true,
      "description": "ソートのキー項目を、カンマ区切りで複数指定可\n●ソートの種類は変更可能　(デフォルト: 文字列昇順)\n 　方法: 項目名末尾に記号を付与 (数値昇順：%n,  文字列降順： %r,  数値降順：%nr)\n●注意 グループ化する項目名と同じ項目名があると、不整合になり、ソートされません"
    },
    {
      "name": "k",
      "type": "string",
      "label": "グループ化する項目名",
      "description": "カンマ区切りで複数指定可\n省略時は全ての行を同じグループとみなして処理される"
    },
    {
      "name": "O",
      "type": "string",
      "label": "NULL値以外を置換する文字列",
      "optional": true
    },
    {
      "name": "A",
      "type": "boolean",
      "label": "置換ではなく、新しい項目として追加する",
      "optional": true,
      "description": "追加する項目名は、対象列名の指定欄で、元の列名とセットで指定する"
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "NULL値の置換",
  "classification": "value_transform",
  "description": "NULL値を指定した文字列に置換する",
  "url": "./static/pdf/mcmd/value_transform/mnullto.pdf",
  "groups": [
    {
      "name": "grouping",
      "label": "グループの設定",
      "params": [
        "k",
        "s"
      ]
    },
    {
      "name": "cmd_main",
      "label": "置換の設定",
      "params": [
        "f",
        "v",
        "A"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "p",
        "O",
        "nfn"
      ]
    },
    {
      "name": "fields",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "tmpPath"
      ]
    }
  ]
}