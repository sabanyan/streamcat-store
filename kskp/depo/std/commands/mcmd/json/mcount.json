{
  "id": "mcount",
  "groups": [
    {
      "name": "grouping",
      "label": "グループの設定",
      "params": [
        "k"
      ]
    },
    {
      "name": "group1",
      "label": "追加する項目名の設定 (必須)",
      "params": [
        "a"
      ]
    },
    {
      "name": "group3",
      "label": "その他（省略可)",
      "params": [
        "q"
      ]
    },
    {
      "name": "group10",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "x",
        "nfn",
        "nfno"
      ]
    },
    {
      "name": "group20",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "tmpPath",
        "assert_diffSize",
        "assert_nullkey"
      ]
    }
  ],
  "rules": {
    "a": {
      "presencesIfTargetIsNotInput": "nfn",
      "format": {
        "pattern": "^[^,]+|^$",
        "message": "一項目のみ入力してください"
      }
    },
    "k": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$|^$",
          "message": "入力値が正しくありません。"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    }
  },
  "params": [
    {
      "name": "a",
      "type": "string",
      "label": "行数の項目名",
      "description": "「入力データの 1 行目を項目名行とみなさない。」指定時は、省略可"
    },
    {
      "name": "k",
      "type": "string",
      "label": "グループ化する項目名",
      "description": "カンマ区切りで複数指定可\n省略時は全ての行を同じグループとみなして処理される"
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目に NULL 値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "description": "入力データがグループ単位でソート済みの場合、指定すると処理速度が向上",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "行数のカウント",
  "classification": "table_grouping",
  "description": "行数をカウントする",
  "url": "./static/pdf/mcmd/table_grouping/mcount.pdf"
}