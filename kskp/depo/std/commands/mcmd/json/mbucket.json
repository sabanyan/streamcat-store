{
  "id": "mbucket",
  "rules": {
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^:,]+:[^:,]+(,[^:,]+:[^:,]+)*$|^@\\[.+\\]$",
          "message": "対象となる列名と新しい列名を、:(コロン)で区切って入力してください"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^[1-9]?[0-9]+L?:[^,:]+(,[1-9]?[0-9]+L?:[^,:]+)*$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "n": {
      "presence": {
        "allowEmpty": false
      },
      "format": {
        "pattern": "^[1-9]?[0-9]+(,[1-9]?[0-9]+)*$|^@\\[.+\\]$",
        "message": "0以上の整数を半角で入力してください"
      }
    },
    "bufcount": {
      "specifiedFormatIfTargetInput": {
        "target": "bufcount",
        "pattern": "^[1-9]?[0-9]*$|^$|^@\\[.+\\]$",
        "message": "0以上の整数を半角で入力してください"
      }
    }
  },
  "params": [
    {
      "name": "f",
      "type": "string",
      "label": "対象列名(必須)"
    },
    {
      "name": "n",
      "type": "string",
      "label": "分割数(必須)"
    },
    {
      "name": "rng",
      "type": "boolean",
      "label": "バケットの範囲均等指定",
      "optional": true
    },
    {
      "name": "r",
      "type": "boolean",
      "label": "バケットの番号を逆順に出力",
      "optional": true
    },
    {
      "name": "F",
      "type": "select",
      "label": "出力形式",
      "options": {
        "labels": [
          "パケット番号のみを表示",
          "パケットの範囲のみを表示",
          "パケット番号とパケット番号の両方を表示"
        ],
        "values": [
          "0",
          "1",
          "2"
        ]
      },
      "optional": true
    },
    {
      "name": "k",
      "type": "string",
      "label": "バケット分割を行う単位となる列名",
      "optional": true
    },
    {
      "name": "bufcount",
      "type": "string",
      "label": "バッファの数",
      "optional": true,
      "default": 10
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目に NULL 値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "一次元均等化バケット分割",
  "classification": "table_split",
  "description": "1つの数値項目を、指定した数の区間に分割する",
  "url": "./static/pdf/mcmd/table_split/mbucket.pdf"
}