{
  "id": "mbucket",
  "rules": {
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^:,]+:[^:,]+(,[^:,]+:[^:,]+)*$|^@\\[.+\\]$",
          "message": "対象となる列名と新しい列名を、:(コロン)で区切って入力してください"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^[1-9]?[0-9]+L?:[^,:]+(,[1-9]?[0-9]+L?:[^,:]+)*$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "n": {
      "presence": {
        "allowEmpty": false
      },
      "format": {
        "pattern": "^[1-9]?[0-9]+(,[1-9]?[0-9]+)*$|^@\\[.+\\]$",
        "message": "0以上の整数を半角で入力してください"
      }
    },
    "bufcount": {
      "specifiedFormatIfTargetInput": {
        "target": "bufcount",
        "pattern": "^[1-9]?[0-9]*$|^$|^@\\[.+\\]$",
        "message": "0以上の整数を半角で入力してください"
      }
    }
  },
  "groups": [
    {
      "name": "group1",
      "label": "グループの設定 (省略可)",
      "params": [
        "k"
      ]
    },
    {
      "name": "group2",
      "label": "バケット分割の設定",
      "params": [
        "f",
        "n",
        "rng"
      ]
    },
    {
      "name": "group4",
      "label": "出力の設定",
      "params": [
        "F",
        "r"
      ]
    },
    {
      "name": "group9",
      "label": "その他 (省略可)",
      "params": [
        "q"
      ]
    },
    {
      "name": "group10",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "x",
        "nfn",
        "nfno"
      ]
    },
    {
      "name": "group20",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "precision",
        "tmpPath",
        "bufcount",
        "assert_diffSize",
        "assert_nullout",
        "assert_nullkey"
      ]
    }
  ],
  "params": [
    {
      "name": "f",
      "type": "string",
      "label": "対象とする項目名と追加項目名の指定(必須)",
      "description": "対象列名、追加列名の順で コロン区切りで指定\nカンマ区切りで複数指定可"
    },
    {
      "name": "n",
      "type": "string",
      "label": "バケット分割の数(必須)",
      "description": "2以上の整数を指定する"
    },
    {
      "name": "rng",
      "type": "boolean",
      "label": "件数ではなく、範囲が均等になるように分割する",
      "optional": true
    },
    {
      "name": "r",
      "type": "boolean",
      "label": "バケットの番号を逆順にして出力する",
      "optional": true
    },
    {
      "name": "F",
      "type": "select",
      "label": "バケットの値の出力形式の設定",
      "description": "番号、範囲の指定が可能(省略時は番号が値となる)",
      "options": {
        "labels": [
          "パケット番号　(例　1,2,...)",
          "パケット範囲　(例　_1.5,1.5_3,...)",
          "パケット番号と範囲　(例　1:_1.5,2:1.5_3,...)"
        ],
        "values": [
          "0",
          "1",
          "2"
        ]
      },
      "optional": true
    },
    {
      "name": "k",
      "type": "string",
      "label": "グループ化する項目名",
      "description": "カンマ区切りで複数指定可",
      "optional": true
    },
    {
      "name": "bufcount",
      "type": "string",
      "label": "バッファの数",
      "optional": true,
      "default": 10
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目に NULL 値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    },
    {
      "name": "precision",
      "type": "string",
      "label": "有効桁数",
      "description": "1〜16の整数(省略時は10)",
      "optional": true,
      "default": 10
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "一次元均等化バケット分割",
  "classification": "table_split",
  "description": "数値項目を、指定した数の区間に分割する",
  "url": "./static/pdf/mcmd/table_split/mbucket.pdf"
}