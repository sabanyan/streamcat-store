{
  "id": "mmvstats",
  "rules": {
    "t": {
      "format": {
        "pattern": "^[1-9].[0-9]*$|^[1-9]$|^$|^@\\[.+\\]$",
        "message": "1以上の整数を半角で入力してください"
      }
    },
    "skip": {
      "format": {
        "pattern": "^(\\+|-)?[1-9]?[0-9]*$|^@\\[.+\\]$|^$",
        "message": "整数を半角で入力してください"
      }
    },
    "s": {
      "presencesIfTargetIsNotInput": "q",
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$|^$",
          "message": "入力が正しくありません"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$",
          "message": "入力が正しくありません"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "k": {
      "format": {
        "pattern": "^[^,]+(,[^,]+)*$|^@\\[.+\\]$|^$",
        "message": "入力が正しくありません"
      }
    },
    "c": {
      "presence": {
        "allowEmpty": false
      }
    }
  },
  "params": [
    {
      "name": "s",
      "type": "string",
      "label": "グループ内ソートの設定",
      "optional": true,
      "description": "ソートのキー項目を、カンマ区切りで複数指定可\n●ソートの種類は変更可能　(デフォルト: 文字列昇順)\n 　方法: 項目名末尾に記号を付与 (数値昇順：%n,  文字列降順： %r,  数値降順：%nr)\n●注意 グループ化する項目名と同じ項目名があると、不整合になり、ソートされません"
    },
    {
      "name": "k",
      "type": "string",
      "label": "グループ化する項目名",
      "optional": true,
      "description": "カンマ区切りで複数指定可\n省略時は全ての行を同じグループとみなして処理される"
    },
    {
      "name": "f",
      "type": "string",
      "label": "集計列名(必須)"
    },
    {
      "name": "t",
      "type": "string",
      "label": "期関数の指定",
      "optional": true
    },
    {
      "name": "c",
      "type": "select",
      "label": "統計量を指定",
      "options": {
        "labels": [
          "合計",
          "算術平均",
          "偏差平方和",
          "分散",
          "分散(不偏推定値)",
          "標準偏差",
          "標準偏差(不偏分散のsqrt)",
          "変動係数",
          "最小値",
          "最大値",
          "範囲",
          "歪度",
          "歪度 (不偏推定値)",
          "尖度",
          "尖度 (不偏推定値)"
        ],
        "values": [
          "sum",
          "mean",
          "devsq",
          "var",
          "uvar",
          "sd",
          "usd",
          "cv",
          "min",
          "max",
          "range",
          "skew",
          "uskew",
          "kurt",
          "ukurt"
        ]
      }
    },
    {
      "name": "skip",
      "type": "string",
      "label": "出力抑制を行う最初の行数指定",
      "optional": true
    },
    {
      "name": "n",
      "type": "boolean",
      "label": "Null データの場合は NULL にするフラグ",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目に NULL 値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目の f=または vf=で指定された項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true,
      "description": "入力データがグループ単位でソート済みの場合、指定すると処理速度が向上"
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    },
    {
      "name": "precision",
      "type": "string",
      "label": "有効桁数",
      "optional": true,
      "default": 10
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "移動窓の統計量の計算",
  "classification": "table_grouping",
  "description": "移動窓を設定し、1つの統計量(1変量)を計算する",
  "url": "./static/pdf/mcmd/table_grouping/mmvstats.pdf",
  "groups": [
    {
      "name": "grouping",
      "label": "グループの設定",
      "params": [
        "k",
        "s"
      ]
    },
    {
      "name": "cmd_main",
      "label": "統計量の計算の設定",
      "params": [
        "f",
        "t",
        "c",
        "skip"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "n",
        "nfn",
        "q",
        "precision"
      ]
    },
    {
      "name": "fields",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullkey",
        "assert_nullin",
        "assert_nullout",
        "tmpPath"
      ]
    }
  ]
}