{
  "id": "mvnullto",
  "rules": {
    "vf": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^:,]+(:[^:,]+)?(,[^:,]+(:[^:,]+)?)*$",
          "message": "入力値が正しくありません。"
        },
        "specialRules": [
          {
            "target": "A",
            "pattern": "^[^:,]+:[^:,]+(,[^:,]+:[^:,]+)*$|^@\\[.+\\]$",
            "message": "対象となる列名と新しい列名を、:(コロン)で区切って入力してください"
          },
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^[1-9]?[0-9]+L?(:[^,:]+)?(,[1-9]?[0-9]+L?(:[^,:]+)?)*$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "v": {
      "onlyOneInput": {
        "target": [
          "p"
        ]
      },
      "format": {
        "pattern": "^[^,]+$|^$",
        "message": "項目名は一つのみ入力してください。"
      }
    },
    "p": {
      "onlyOneInput": {
        "target": [
          "v"
        ]
      }
    }
  },
  "params": [
    {
      "name": "vf",
      "type": "string",
      "label": "対象とする項目名(必須)"
    },
    {
      "name": "v",
      "type": "string",
      "label": "置換文字列",
      "optional": true
    },
    {
      "name": "p",
      "type": "boolean",
      "label": "直前の要素で置換する。v=と同時に指定はできない。",
      "optional": true
    },
    {
      "name": "O",
      "type": "string",
      "label": "NULL 値以外の要素を全て、ここで指定した文字列に置換する。",
      "optional": true
    },
    {
      "name": "A",
      "type": "boolean",
      "label": "vf=で:(コロン) に続けて指定した項目名で、新たな項目が追加される。",
      "optional": true
    },
    {
      "name": "delim",
      "type": "string",
      "label": "ベクトル要素の区切り文字",
      "optional": true,
      "description": "省略時は半角スペース"
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=またはvf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "ベクトルのNULL要素の置換",
  "classification": "value_transform",
  "description": "ベクトル要素でNULLの要素を任意の値に置換する",
  "url": "./static/pdf/mcmd/value_transform/mvnullto.pdf",
  "groups": [
    {
      "name": "cmd_main",
      "label": "要素の置換の設定",
      "params": [
        "vf",
        "v",
        "A"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "p",
        "O",
        "delim",
        "nfn"
      ]
    },
    {
      "name": "fields",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullin",
        "assert_nullout",
        "tmpPath"
      ]
    }
  ]
}