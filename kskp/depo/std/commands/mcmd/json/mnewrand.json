{
  "id": "mnewrand",
  "rules": {
    "a": {
      "presence": {
        "allowEmpty": false
      }
    }
  },
  "params": [
    {
      "name": "a",
      "type": "string",
      "label": "新規作成する連番行の項目名(必須)"
    },
    {
      "name": "max",
      "type": "string",
      "label": "乱数の最大値",
      "optional": true
    },
    {
      "name": "min",
      "type": "string",
      "label": "乱数の最小値",
      "optional": true
    },
    {
      "name": "S",
      "type": "string",
      "label": "乱数のシード",
      "optional": true
    },
    {
      "name": "l",
      "type": "string",
      "label": "作成するデータ行数",
      "optional": true,
      "default": "10"
    },
    {
      "name": "int",
      "type": "boolean",
      "label": "整数乱数を生成する",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "乱数データの新規生成",
  "classification": "data_source",
  "description": "実数/整数の乱数で、指定した行数を作成する",
  "url": "",
  "groups": [
    {
      "name": "cmd_main",
      "label": "データ生成の設定",
      "params": [
        "a",
        "l",
        "int"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "S",
        "max",
        "min",
        "nfn"
      ]
    },
    {
      "name": "fields",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "tmpPath"
      ]
    }
  ]
}