{
  "id": "mpadding",
  "rules": {
    "k": {
      "format": {
        "pattern": "^[^,]+(,[^,]+)*$|^@\\[.+\\]$|^$",
        "message": "入力が正しくありません"
      }
    },
    "S": {
      "format": {
        "pattern": "^(\\+|-)?[1-9]?[0-9]*$|^$|^@\\[.+\\]$",
        "message": "整数を半角で入力してください"
      }
    },
    "E": {
      "format": {
        "pattern": "^(\\+|-)?[1-9]?[0-9]*$|^$|^@\\[.+\\]$",
        "message": "整数を半角で入力してください"
      }
    },
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(%[ndr]){0,3}$",
          "message": "入力値が正しくありません。"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(%[ndr]){0,3}|^@\\[.+\\](%[ndr]){0,3}$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    }
  },
  "params": [
    {
      "name": "k",
      "type": "string",
      "label": "グループ化する項目名",
      "optional": true,
      "description": "カンマ区切りで複数指定可\n省略時は全ての行を同じグループとみなして処理される"
    },
    {
      "name": "f",
      "type": "string",
      "label": "補完対象の項目名(必須)"
    },
    {
      "name": "v",
      "type": "string",
      "label": "パディング用文字列",
      "optional": true
    },
    {
      "name": "S",
      "type": "string",
      "label": "開始値",
      "optional": true
    },
    {
      "name": "E",
      "type": "string",
      "label": "終了値",
      "optional": true
    },
    {
      "name": "n",
      "type": "boolean",
      "label": "k=,f=で指定した以外の項目値を null で出力する。",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目にNULL値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=またはvf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true,
      "description": "入力データがグループ単位でソート済みの場合、指定すると処理速度が向上"
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "行の補完",
  "classification": "row_edit",
  "description": "項目の値が連続するようにレコードを追加する",
  "url": "./static/pdf/mcmd/row_edit/mpadding.pdf",
  "groups": [
    {
      "name": "grouping",
      "label": "グループの設定",
      "params": [
        "k"
      ]
    },
    {
      "name": "cmd_main",
      "label": "行補完の設定",
      "params": [
        "f",
        "S",
        "E",
        "v",
        "n"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "q",
        "x",
        "nfn",
        "nfno"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullkey",
        "assert_nullin",
        "assert_nullout",
        "tmpPath"
      ]
    }
  ]
}