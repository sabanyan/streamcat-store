{
  "id": "mrand",
  "rules": {
    "k": {
      "format": {
        "pattern": "^[^,]+(,[^,]+)*$|^$",
        "message": "入力が正しくありません。"
      }
    },
    "max": {
      "format": {
        "pattern": "^[1-9]?[0-9]*$|^$|^@\\[.+\\]$",
        "message": "0以上の整数を半角で入力してください"
      },
      "compareNumbersLargerThan": {
        "target": "min",
        "message": "minより数値が大きくなるよう入力してください。"
      }
    },
    "min": {
      "format": {
        "pattern": "^[1-9]?[0-9]*$|^$|^@\\[.+\\]$",
        "message": "0以上の整数を半角で入力してください"
      }
    },
    "a": {
      "presencesIfTargetIsNotInput": [
        "nfn",
        "nfno"
      ],
      "specifiedFormatIfTargetInput": {
        "target": "a",
        "pattern": "^[^,]+$|^$",
        "message": "入力が正しくありません。"
      }
    },
    "int": {
      "presencesIfTargetIsInput": [
        "max",
        "min"
      ]
    },
    "S": {
      "specifiedFormatIfTargetInput": {
        "target": "S",
        "pattern": "^[1-9]?[0-9]*$|^$|^@\\[.+\\]$",
        "message": "入力が正しくありません。"
      }
    }
  },
  "params": [
    {
      "name": "k",
      "type": "string",
      "label": "グループ化する項目名",
      "optional": true,
      "description": "・カンマ区切りで複数指定可\n・省略時は全ての行を同じグループとみなして処理される"
    },
    {
      "name": "a",
      "type": "string",
      "label": "乱数の項目名 (必須)"
    },
    {
      "name": "max",
      "type": "string",
      "label": "整数乱数の最大値",
      "optional": true,
      "description": "「整数乱数を生成時する」有効時のみ指定可能"
    },
    {
      "name": "min",
      "type": "string",
      "label": "整数乱数の最小値",
      "optional": true,
      "description": "「整数乱数を生成時する」有効時のみ指定可能"
    },
    {
      "name": "S",
      "type": "string",
      "label": "乱数のシード値　(省略可)",
      "optional": true,
      "description": "同じ乱数系列を発生させたい場合に指定する\nデフォルトは時刻値で、実行の都度変化する"
    },
    {
      "name": "int",
      "type": "boolean",
      "label": "整数乱数を生成する",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目にNULL値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true,
      "description": "入力データがグループ単位でソート済みの場合、指定すると処理速度が向上"
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "擬似乱数の付与",
  "classification": "col_edit",
  "description": "擬似乱数を生成する",
  "url": "./static/pdf/mcmd/col_edit/mrand.pdf",
  "groups": [
    {
      "name": "abstract",
      "label": "擬似乱数の付与",
      "description": "擬似乱数を生成する",
      "params": []
    },
    {
      "name": "grouping",
      "label": "グループの設定 (省略可)",
      "params": [
        "k"
      ]
    },
    {
      "name": "cmd_main",
      "label": "乱数生成の設定 (必須)",
      "params": [
        "a",
        "int",
        "min",
        "max",
        "S"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "q",
        "nfn",
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullkey",
        "tmpPath"
      ]
    }
  ]
}