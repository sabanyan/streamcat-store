{
  "id": "mnewstr",
  "rules": {
    "a": {
      "presence": {
        "allowEmpty": false
      }
    },
    "v": {
      "lessValueListThanN": {
        "target": "a",
        "difference": "0",
        "justValue": "-1"
      }
    }
  },
  "params": [
    {
      "name": "a",
      "type": "string",
      "label": "項目名の設定(必須)",
      "description": "複数項目の指定は不可"
    },
    {
      "name": "v",
      "type": "string",
      "label": "追加する値(必須)",
      "optional": true
    },
    {
      "name": "l",
      "type": "string",
      "label": "生成データの行数(必須)",
      "optional": true,
      "default": "10",
      "description": "正の整数で設定する"
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "固定文字列データの新規生成",
  "classification": "data_source",
  "description": "固定文字列で、指定した行数を作成する（複数列対応）",
  "url": "",
  "groups": [
    {
      "name": "cmd_main",
      "label": "文字列データ生成の設定(必須)",
      "params": [
        "a",
        "v",
        "l"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "nfn",
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "tmpPath"
      ]
    }
  ]
}