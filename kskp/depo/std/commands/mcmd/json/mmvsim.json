{
  "id": "mmvsim",
  "rules": {
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$|^@\\[.+\\]$",
          "message": "入力が正しくありません"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?$|^@\\[.+\\]$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "k": {
      "format": {
        "pattern": "^[^,]+(,[^,]+)*$|^@\\[.+\\]$|^$",
        "message": "入力が正しくありません"
      }
    },
    "t": {
      "format": {
        "pattern": "^[1-9].[0-9]*$|^[1-9]$|^@\\[.+\\]$|^$",
        "message": "1以上の整数を半角で入力してください"
      }
    },
    "skip": {
      "format": {
        "pattern": "^(\\+|-)?[1-9]?[0-9]*$|^0$|^@\\[.+\\]$|^$",
        "message": "整数を半角で入力してください"
      }
    },
    "s": {
      "presencesIfTargetIsNotInput": "q",
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$|^$",
          "message": "入力が正しくありません"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "c": {
      "presence": {
        "allowEmpty": false
      }
    },
    "a": {
      "presence": {
        "allowEmpty": false
      },
      "format": {
        "pattern": "^[^,]+$",
        "message": "項目数は1つのみです。"
      }
    }
  },
  "params": [
    {
      "name": "s",
      "type": "string",
      "label": "並べ替えの後、各種類似度を計算する列名",
      "optional": true
    },
    {
      "name": "k",
      "type": "string",
      "label": "単位とする列名",
      "optional": true
    },
    {
      "name": "f",
      "type": "string",
      "label": "集計列名(必須)"
    },
    {
      "name": "c",
      "type": "select",
      "label": "類似度名を指定",
      "options": {
        "labels": [
          "共分散",
          "普偏共分散",
          "ピアソンの積率相関係数",
          "スピアマンの順位相関係数",
          "ケンドールの順位相関係数",
          "ユークリッド距離(数値)",
          "コサイン",
          "都市ブロック距離",
          "ハミング距離",
          "カイ2乗値",
          "ファイ係数",
          "ジャックカード係数",
          "支持度",
          "リフト値"
        ],
        "values": [
          "covar",
          "ucovar",
          "pearson",
          "spearman",
          "kendall",
          "euclid",
          "cosine",
          "cityblock",
          "hamming",
          "chi",
          "phi",
          "jaccard",
          "support",
          "lift"
        ]
      }
    },
    {
      "name": "a",
      "type": "string",
      "label": "新規に作成する項目名(必須)"
    },
    {
      "name": "t",
      "type": "string",
      "label": "期間数の指定",
      "optional": true
    },
    {
      "name": "skip",
      "type": "string",
      "label": "出力抑制を行う最初の行数指定",
      "optional": true
    },
    {
      "name": "n",
      "type": "boolean",
      "label": "Null データの場合は NULL にするフラグ",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目に NULL 値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目の f=または vf=で指定された項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    },
    {
      "name": "precision",
      "type": "string",
      "label": "有効桁数",
      "optional": true,
      "default": 10
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "移動窓の類似度の計算",
  "classification": "table_grouping",
  "description": "移動窓を設定し、各種類似度(2変量の統計量)を計算する",
  "url": "./static/pdf/mcmd/table_grouping/mmvsim.pdf",
  "groups": [
    {
      "name": "grouping",
      "label": "グループの設定",
      "params": [
        "k"
      ]
    },
    {
      "name": "sorting",
      "label": "グループ内のソートの設定",
      "params": [
        "s"
      ]
    },
    {
      "name": "cmd_main",
      "label": "〇〇の設定",
      "params": [
        "f",
        "c",
        "a",
        "t",
        "skip"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "n",
        "nfn",
        "q",
        "precision"
      ]
    },
    {
      "name": "fields",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullkey",
        "assert_nullin",
        "assert_nullout",
        "tmpPath"
      ]
    }
  ]
}