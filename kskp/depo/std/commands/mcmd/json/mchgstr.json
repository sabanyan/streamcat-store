{
  "id": "mchgstr",
  "rules": {
    "c": {
      "presence": {
        "allowEmpty": false
      },
      "format": {
        "pattern": "^[^:,]+:[^:,]+(,[^:,]+:[^:,]+)*$|^@\\[.+\\]$",
        "message": "置換対象となる文字列と置換文字列を、:(コロン)で区切って入力してください"
      }
    },
    "O": {
      "format": {
        "pattern": "^[^,]*$",
        "message": "この項目にて,(コンマ)は入力しないでください。"
      }
    },
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^:,]+(:[^:,]+)?(,[^:,]+(:[^:,]+)?)*$",
          "message": "入力値が正しくありません。"
        },
        "specialRules": [
          {
            "target": "A",
            "pattern": "^[^:,]+:[^:,]+(,[^:,]+:[^:,]+)*$|^@\\[.+\\]$",
            "message": "対象となる列名と新しい列名を、:(コロン)で区切って入力してください"
          },
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^[1-9]?[0-9]+L?(:[^,:]+)?(,[1-9]?[0-9]+L?(:[^,:]+)?)*$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    }
  },
  "params": [
    {
      "name": "c",
      "type": "string",
      "label": "置換の設定(必須)",
      "description": "置換対象となる文字列と、置換文字列を : 区切りで指定する\nカンマ区切りで複数指定可"
    },
    {
      "name": "f",
      "type": "string",
      "label": "対象とする項目名 (必須)",
      "description": "●カンマ区切りで複数指定可\n●ワイルドカード(*,？ )使用可"
    },
    {
      "name": "O",
      "type": "string",
      "label": "マッチしない場合の置換文字列(省略可)",
      "optional": true,
      "description": "指定がない場合は、NULL(つまり空文字)で置換される"
    },
    {
      "name": "A",
      "type": "boolean",
      "label": "置換ではなく、項目を追加して出力する",
      "optional": true,
      "description": "追加する項目名は、対象となる項目名の後に、:区切りで入力する"
    },
    {
      "name": "F",
      "type": "boolean",
      "label": "マッチしない場合は元の値のままで出力する",
      "optional": true
    },
    {
      "name": "sub",
      "type": "boolean",
      "label": "部分文字列マッチで置換する",
      "optional": true,
      "description": "値全体ではなく、一致した部分文字列が置換されます"
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "対象とする項目名で指定された項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "文字列の置換",
  "classification": "value_transform",
  "description": "文字列を置換する",
  "url": "./static/pdf/mcmd/value_transform/mchgstr.pdf",
  "groups": [
    {
      "name": "cmd_main",
      "label": "置換の設定(必須)",
      "params": [
        "f",
        "c",
        "A",
        "O",
        "F",
        "sub",
        "W"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "nfn",
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullin",
        "assert_nullout",
        "tmpPath"
      ]
    }
  ]
}