{
  "id": "mselstr",
  "rules": {
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$",
          "message": "入力が正しくありません"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "v": {
      "presence": {
        "allowEmpty": false
      },
      "format": {
        "pattern": "^[^,]+(,[^,]+)*$",
        "message": "入力が正しくありません"
      }
    },
    "k": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$|^$",
          "message": "入力が正しくありません"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "bufcount": {
      "specifiedFormatIfTargetInput": {
        "target": "bufcount",
        "pattern": "^[1-9]?[0-9]*$|^0$|^$",
        "message": "0以上の整数を半角で入力してください"
      }
    }
  },
  "params": [
    {
      "name": "f",
      "type": "string",
      "label": "対象列名"
    },
    {
      "name": "v",
      "type": "string",
      "label": "絞込条件値（文字列）"
    },
    {
      "name": "k",
      "type": "string",
      "label": "グループ化する項目名",
      "optional": true,
      "description": "カンマ区切りで複数指定可\n省略時は全ての行を同じグループとみなして処理される"
    },
    {
      "name": "F",
      "type": "boolean",
      "label": "f= パラメータで複数項目を指定した場合、その全ての値がマッチする行を撰択する。",
      "optional": true
    },
    {
      "name": "r",
      "type": "boolean",
      "label": "選択ではなく削除する。",
      "optional": true
    },
    {
      "name": "R",
      "type": "boolean",
      "label": "k= パラメータを指定した場合、その全ての行がマッチすれば行を撰択する。",
      "optional": true
    },
    {
      "name": "sub",
      "type": "boolean",
      "label": "検索を完全一致ではなく部分文字列マッチで比較する。",
      "optional": true
    },
    {
      "name": "head",
      "type": "boolean",
      "label": "先頭文字列マッチオプション",
      "optional": true
    },
    {
      "name": "tail",
      "type": "boolean",
      "label": "末尾文字列マッチオプション",
      "optional": true
    },
    {
      "name": "W",
      "type": "boolean",
      "label": "sub,head,tail オプションが指定されているときにワイド文字として部分文字列マッチをおこなう。",
      "optional": true
    },
    {
      "name": "bufcount",
      "type": "string",
      "label": "バッファの数",
      "optional": true,
      "default": 10
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目にNULL値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=またはvf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true,
      "description": "入力データがグループ単位でソート済みの場合、指定すると処理速度が向上"
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      },
      {
        "name": "u",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "文字列による行選択",
  "classification": "row_edit",
  "description": "指定した文字列に一致する行を選択する",
  "url": "./static/pdf/mcmd/row_edit/mselstr.pdf",
  "groups": [
    {
      "name": "grouping",
      "label": "グループの設定",
      "params": [
        "k"
      ]
    },
    {
      "name": "cmd_main",
      "label": "行選択の設定",
      "params": [
        "f",
        "v",
        "F",
        "bufcount"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "r",
        "R",
        "sub",
        "head",
        "tail",
        "W",
        "nfn",
        "q"
      ]
    },
    {
      "name": "fields",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullkey",
        "assert_nullin",
        "tmpPath"
      ]
    }
  ]
}