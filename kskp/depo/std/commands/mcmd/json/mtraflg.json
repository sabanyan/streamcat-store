{
  "id": "mtraflg",
  "rules": {
    "delim": {
      "format": {
        "pattern": "^[ -~]{0,1}$",
        "message": "1バイト文字を一文字入力してください"
      }
    },
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$|^$",
          "message": "入力が正しくありません"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "a": {
      "presence": {
        "allowEmpty": false
      },
      "format": {
        "pattern": "^[^,]+$",
        "message": "項目名は一つのみ入力してください。"
      }
    }
  },
  "params": [
    {
      "name": "a",
      "type": "string",
      "label": "トランザクション列名(必須)"
    },
    {
      "name": "f",
      "type": "string",
      "label": "列名リスト(必須)"
    },
    {
      "name": "delim",
      "type": "string",
      "label": "トランザクション項目アイテムを区切る文字",
      "optional": true,
      "default": " "
    },
    {
      "name": "r",
      "type": "boolean",
      "label": "トランザクション型から縦型へデータを変換する。",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=またはvf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "クロス表をトランザクション項目に変換(Mtraflg)",
  "classification": "value_crossing",
  "description": "複数項目の項目名を要素とするベクトル項目を作成する",
  "url": "./static/pdf/mcmd/value_crossing/mtraflg.pdf",
  "groups": [
    {
      "name": "cmd_main",
      "label": "〇〇の設定",
      "params": [
        "a",
        "f"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "delim",
        "r",
        "nfn",
        "q"
      ]
    },
    {
      "name": "fields",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullin",
        "assert_nullout",
        "tmpPath"
      ]
    }
  ]
}