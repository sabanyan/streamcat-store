{
  "id": "mcombi",
  "rules": {
    "a": {
      "presencesIfTargetIsNotInput": [
        "nfn",
        "nfno"
      ],
      "specifiedFormatIfTargetInput": {
        "target": "a",
        "pattern": "^[^,]+$|^$",
        "message": "入力が正しくありません。"
      }
    },
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$",
          "message": "入力値が正しくありません。"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "k": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$|^$",
          "message": "入力値が正しくありません。"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "n": {
      "presence": {
        "allowEmpty": false
      },
      "format": {
        "pattern": "^[1-9]?[0-9]*$|^@\\[.+\\]$",
        "message": "1以上の整数を半角で入力してください"
      }
    }
  },
  "params": [
    {
      "name": "a",
      "type": "string",
      "label": "追加列名(必須)"
    },
    {
      "name": "f",
      "type": "string",
      "label": "組み合わせ列名(必須)"
    },
    {
      "name": "n",
      "type": "string",
      "label": "組み合わせ数(必須)"
    },
    {
      "name": "s",
      "type": "string",
      "label": "並び替えの後、f=で指定の列の組み合わせを求める列名",
      "optional": true
    },
    {
      "name": "k",
      "type": "string",
      "label": "キー列名",
      "optional": true
    },
    {
      "name": "p",
      "type": "boolean",
      "label": "組合せでなく順列を求める",
      "optional": true
    },
    {
      "name": "dup",
      "type": "boolean",
      "label": "同一の値の組み合せも出力する",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=またはvf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "組合せの生成",
  "classification": "value_crossing",
  "description": "f=で指定した項目についてn=で指定した数の組み合わせを求め、a=で指定した項目名で出力する",
  "url": "./static/pdf/mcmd/value_crossing/mcombi.pdf"
}