{
  "id": "msim",
  "rules": {
    "c": {
      "presence": {
        "allowEmpty": false
      }
    },
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)+$",
          "message": "2つ以上の項目を指定してください"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "a": {
      "format": {
        "pattern": "^[^,]+,[^,]+$|^$|^@\\[.+\\]$",
        "message": "対象となる列名を2つ入力してください"
      }
    },
    "bufcount": {
      "specifiedFormatIfTargetInput": {
        "target": "bufcount",
        "pattern": "^[1-9]?[0-9]*$|^0$|^$",
        "message": "0以上の整数を半角で入力してください"
      }
    }
  },
  "params": [
    {
      "name": "c",
      "type": "select",
      "label": "類似度の選択 (必須)",
      "description": "項目名には、カッコ内の名前が使用される",
      "options": {
        "multiple": true,
        "labels": [
          "共分散 (covar)",
          "不偏共分散 (ucovar)",
          "ピアソンの積率相関係数 (pearson)",
          "スピアマンの順位相関係数 (spearman)",
          "ケンドールの順位相関係数 (kendall)",
          "ユークリッド距離 (euclid)",
          "コサイン (cosine)",
          "都市ブロック距離 (cityblock)",
          "ハミング距離 (hamming)",
          "カイ2乗値 (chi)",
          "ファイ係数 (phi)",
          "ジャッカード係数 (jaccard)",
          "支持度 (support)",
          "リフト値 (lift)",
          "最大確信度 (confMax)",
          "最小確信度 (confMin)",
          "yuleのQ連関係数 (yuleQ)",
          "yuleのY連関係数 (yuleY)",
          "カッパ値 (kappa)",
          "オッズ比 (oddsRatio)",
          "最大確信度 (convMax)",
          "最小確信度 (convMin)"
        ],
        "values": [
          "covar",
          "ucovar",
          "pearson",
          "spearman",
          "kendall",
          "euclid",
          "cosine",
          "cityblock",
          "hamming",
          "chi",
          "phi",
          "jaccard",
          "support",
          "lift",
          "confMax",
          "confMin",
          "yuleQ",
          "yuleY",
          "kappa",
          "oddsRatio",
          "convMax",
          "convMin"
        ]
      }
    },
    {
      "name": "f",
      "type": "string",
      "label": "対象とする項目名 (必須)",
      "description": "・カンマ区切りで複数指定可\n・ワイルドカード(*,？ )使用可"
    },
    {
      "name": "a",
      "type": "string",
      "label": "追加する項目名 (必須)",
      "optional": true,
      "default": "fld1,fld2",
      "description": "・項目名の組合せを展開する項目名を、２つ指定する"
    },
    {
      "name": "k",
      "type": "string",
      "label": "グループ化する項目名",
      "optional": true,
      "description": "・カンマ区切りで複数指定可\n・省略時は全ての行を同じグループとみなして処理される"
    },
    {
      "name": "n",
      "type": "boolean",
      "label": "NULLが含まれている時は、結果をNULLで出力する",
      "optional": true
    },
    {
      "name": "d",
      "type": "boolean",
      "label": "同項目の組合せや、項目を入替えた場合の類似度も計算して出力する",
      "optional": true
    },
    {
      "name": "bufcount",
      "type": "string",
      "label": "バッファのブロック数",
      "optional": true,
      "default": 10,
      "description": "デフォルト:10 (40MB)"
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目にNULL値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "対象とする項目名で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true,
      "description": "入力データがグループ単位でソート済みの場合、指定すると処理速度が向上"
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "二変数間の類似度の計算",
  "classification": "table_grouping",
  "description": "二変数間の類似度(距離)を計算し類似度行列として出力する",
  "url": "./static/pdf/mcmd/table_grouping/msim.pdf",
  "groups": [
    {
      "name": "abstract",
      "label": "コマンドの概要",
      "description": "・対象とする項目名の組合せ別に、類似度を計算する\n・類似度名は項目名として出力され、項目名の組合せは、追加する項目の値として展開されて出力される",
      "params": []
    },
    {
      "name": "grouping",
      "label": "グループの設定 (省略可)",
      "params": [
        "k"
      ]
    },
    {
      "name": "cmd_main",
      "label": "類似度計算の設定 (必須)",
      "params": [
        "f",
        "c",
        "a",
        "n",
        "d"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "q",
        "nfn",
        "x",
        "nfno",
        "bufcount"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullkey",
        "assert_nullin",
        "assert_nullout",
        "tmpPath"
      ]
    }
  ]
}