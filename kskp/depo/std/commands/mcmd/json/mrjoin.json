{
  "id": "mrjoin",
  "groups": [
    {
      "name": "group1",
      "label": "グループの設定 (省略可)",
      "params": [
        "k"
      ]
    },
    {
      "name": "group5",
      "label": "〇〇の設定 (必須)",
      "params": [
        "f",
        "n",
        "lo",
        "K",
        "R",
        "rf"
      ]
    },
    {
      "name": "group10",
      "label": "その他 (省略可)",
      "params": [
        "q"
      ]
    },
    {
      "name": "group15",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "x",
        "nfn",
        "nfno"
      ]
    },
    {
      "name": "group20",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "tmpPath",
        "assert_diffSize",
        "assert_nullout",
        "assert_nullkey",
        "assert_nullin"
      ]
    }
  ],
  "rules": {
    "f": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^:,]+(,[^:,]+)*$|^$",
          "message": "対象となる列名を入力してください"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "rf": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(%[ndr]){0,3}(,[^,]+(%[ndr]){0,3})*$",
          "message": "入力値が正しくありません。"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(%[ndr]){0,3}(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(%[ndr]){0,3})*$|^@\\[.+\\](%[ndr]){0,3}$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "k": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^:,]+(,[^:,]+)*$|^$",
          "message": "対象となる列名を入力してください"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "K": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^:,]+(,[^:,]+)*$|^$",
          "message": "対象となる列名を入力してください"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "R": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^:,]+(,[^:,]+)*$|^$",
          "message": "対象となる列名を入力してください"
        }
      }
    }
  },
  "params": [
    {
      "name": "rf",
      "type": "string",
      "label": "範囲比較を行う入力ファイル上の列名(必須)"
    },
    {
      "name": "k",
      "type": "string",
      "label": "入力データの結合キー名",
      "optional": true
    },
    {
      "name": "K",
      "type": "string",
      "label": "参照データの結合キー名",
      "optional": true
    },
    {
      "name": "R",
      "type": "string",
      "label": "参照ファイルの範囲列名",
      "optional": true
    },
    {
      "name": "f",
      "type": "string",
      "label": "参照ファイルの結合列",
      "optional": true
    },
    {
      "name": "n",
      "type": "boolean",
      "label": "参照データにない入力データを NULL 値として出力する",
      "optional": true
    },
    {
      "name": "lo",
      "type": "boolean",
      "label": "R= パラメータで指定した範囲を左半開区間(より大きい~以下)と解釈する。",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目にNULL値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=またはvf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      },
      {
        "name": "m",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "参照データの範囲条件による結合",
  "classification": "table_join",
  "description": "r=で指定した項目値が、m=で指定s多参照ファイルのR=で指定した２項目値の範囲条件にマッチすれば、f=の項目を結合する。",
  "url": "./static/pdf/mcmd/table_join/mrjoin.pdf"
}