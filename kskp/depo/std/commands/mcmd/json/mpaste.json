{
  "id": "mpaste",
  "rules": {
    "f": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$|^$",
          "message": "入力値が正しくありません。"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    }
  },
  "params": [
    {
      "name": "f",
      "type": "string",
      "label": "参照データの結合キー名",
      "optional": true
    },
    {
      "name": "n",
      "type": "boolean",
      "label": "入力ファイルにあって参照ファイルにない場合にNULL値を出力する。"
    },
    {
      "name": "N",
      "type": "boolean",
      "label": "参照ファイルにあって入力ファイルにない場合にNULL値を出力する。"
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=またはvf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      },
      {
        "name": "m",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "行番号による結合",
  "classification": "table_join",
  "description": "行番号でマッチングさせて結合する",
  "url": "./static/pdf/mcmd/table_join/mpaste.pdf",
  "groups": [
    {
      "name": "merge_type",
      "label": "結合方法の設定  (省略時は 共通部分を出力)",
      "params": [
        "n",
        "N"
      ]
    },
    {
      "name": "merge_fields",
      "label": "結合する項目の設定",
      "params": [
        "f"
      ]
    },
    {
      "name": "merge_sub",
      "label": "その他 (省略可)",
      "params": [
        "q"
      ]
    },
    {
      "name": "fields",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "nfn",
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullin",
        "assert_nullout",
        "tmpPath"
      ]
    }
  ]
}