{
  "id": "mchgnum",
  "rules": {
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$",
          "message": "入力値が正しくありません。"
        },
        "specialRules": [
          {
            "target": "A",
            "pattern": "^[^:,]+:[^:,]+(,[^:,]+:[^:,]+)*$|^@\\[.+\\]$",
            "message": "対象となる列名と新しい列名を、:(コロン)で区切って入力してください"
          },
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^[1-9]?[0-9]+L?(:[^,:]+)?(,[1-9]?[0-9]+L?(:[^,:]+)?)*$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "O": {
      "format": {
        "pattern": "^[^,]*$",
        "message": "この項目にて,(コンマ)は入力しないでください。"
      },
      "onlyOneInput": {
        "target": "F"
      }
    },
    "R": {
      "presence": {
        "allowEmpty": false
      },
      "format": {
        "pattern": "^(MIN|(\\+|-)?[1-9]?[0-9]+(\\.[0-9]*)?)(,(\\+|-)?[1-9]?[0-9]+(\\.[0-9]*)?)*(,(MAX|(\\+|-)?[1-9]?[0-9]+(\\.[0-9]*)?))$|^@\\[.+\\]$",
        "message": "数値範囲の指定は,(コンマ)で区切って入力してください。MINは一番左側のみ、MAXは一番右側のみに入力可能です。"
      },
      "checkArrangementSequences": true
    },
    "v": {
      "lessValueListThanN": {
        "target": "R",
        "difference": "1",
        "justValue": "-1"
      }
    },
    "F": {
      "onlyOneInput": {
        "target": "O"
      }
    }
  },
  "params": [
    {
      "name": "f",
      "type": "string",
      "label": "置換対象列(必須)"
    },
    {
      "name": "R",
      "type": "string",
      "label": "置換対象となる数の範囲(必須)"
    },
    {
      "name": "O",
      "type": "string",
      "label": "R=に無い数または文字列を置換する場合の文字列",
      "optional": true
    },
    {
      "name": "v",
      "type": "string",
      "label": "R=にて指定した値に対応する置換文字列",
      "optional": true
    },
    {
      "name": "F",
      "type": "boolean",
      "label": "範囲外を項目の値として出力",
      "optional": true
    },
    {
      "name": "A",
      "type": "boolean",
      "label": "指定した項目を置き換えるのではなく、新たに項目が追加される",
      "optional": true
    },
    {
      "name": "r",
      "type": "boolean",
      "label": "R=パラメータの範囲を’~より大きく~以下’ として扱う",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目の f=または vf=で指定された項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "数値範囲による置換",
  "classification": "value_transform",
  "description": "数値範囲条件をもとに、置換文字へ変換する",
  "url": "./static/pdf/mcmd/value_transform/mchgnum.pdf",
  "groups": [
    {
      "name": "cmd_main",
      "label": "〇〇の設定",
      "params": [
        "f",
        "v",
        "F",
        "A"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "R",
        "O",
        "r",
        "nfn",
        "q"
      ]
    },
    {
      "name": "fields",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullin",
        "assert_nullout",
        "tmpPath"
      ]
    }
  ]
}