{
  "id": "mselrand",
  "rules": {
    "c": {
      "presencesIfTargetIsNotInput": "p",
      "format": {
        "pattern": "^[1-9][0-9]*$|^[1-9]$|^@\\[.+\\]$|^$",
        "message": "1以上の整数を半角で入力してください"
      },
      "onlyOneInput": {
        "target": "p"
      }
    },
    "p": {
      "presencesIfTargetIsNotInput": "c",
      "format": {
        "pattern": "^-?[1-9]?[0-9]*(\\.[0-9]+)?$|^@\\[.+\\]$|^$",
        "message": "数字を半角で入力してください"
      },
      "onlyOneInput": {
        "target": "c"
      }
    },
    "S": {
      "format": {
        "pattern": "^[1-9]?[0-9]*$|^0$|^$|^@\\[.+\\]$",
        "message": "0以上の整数を半角で入力してください"
      }
    },
    "k": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$|^$",
          "message": "入力が正しくありません"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    }
  },
  "params": [
    {
      "name": "c",
      "type": "string",
      "label": "各キーの値毎に選択する行数(pとどちらか必須)"
    },
    {
      "name": "p",
      "type": "string",
      "label": "各キーを選択する割合をパーセンテージで指定(cとどちらか必須)"
    },
    {
      "name": "k",
      "type": "string",
      "label": "選択単位となるキー列",
      "optional": true
    },
    {
      "name": "S",
      "type": "string",
      "label": "乱数の種",
      "optional": true
    },
    {
      "name": "B",
      "type": "boolean",
      "label": "キー単位選択",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目にNULL値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      },
      {
        "name": "u",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "ランダムに行を選択",
  "classification": "row_edit",
  "description": "c=もしくはp=で指定した行数をランダムに選択する。",
  "url": "./static/pdf/mcmd/row_edit/mselrand.pdf"
}