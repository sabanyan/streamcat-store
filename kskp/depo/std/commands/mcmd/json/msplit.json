{
  "id": "msplit",
  "groups": [
    {
      "name": "group0",
      "label": "概要",
      "params": [
      ],
      "description":"対象とする項目の値を区切り文字で分割し、新しい項目に先頭から順番に割り当てる\n\n注意:\n 項目数不足時：収まらない値は無視される\n 項目数が余る時: 余った項目の値はNULLとする"
    },    
    {
      "name": "group2",
      "label": "分割の設定",
      "params": [
        "f",
        "delim"
      ]
    },
    {
      "name": "group4",
      "label": "追加する項目名の設定(必須)",
      "params": [
        "a"
      ]
    },
    {
      "name": "group3",
      "label": "その他(省略可)",
      "params": [
        "r"
      ]
    },
    {
      "name": "group10",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "x",
        "nfn",
        "nfno"
      ]
    },
    {
      "name": "group20",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "precision",
        "tmpPath",
        "assert_diffSize",
        "assert_nullout",
        "assert_nullkey"
      ]
    }
  ],
  "rules": {
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$",
          "message": "入力が正しくありません"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "a": {
      "presence": {
        "allowEmpty": false
      },
      "format": {
        "pattern": "^[^:,]+(,[^:,]+)*$",
        "message": "入力が正しくありません。"
      }
    }
  },
  "params": [
    {
      "name": "f",
      "type": "string",
      "label": "対象とする項目名",
      "description": "1項目のみ指定可能"
    },
    {
      "name": "delim",
      "type": "string",
      "label": "区切り文字",
      "description": "省略時は半角スペース"
    },
    {
      "name": "a",
      "type": "string",
      "label": "分割した値の項目名",
      "description":"カンマ区切りで指定する"
    },
    {
      "name": "r",
      "type": "boolean",
      "label": "分割前の項目は削除して出力する",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    },
    {
      "name": "precision",
      "type": "string",
      "label": "有効桁数",
      "optional": true,
      "default": 10
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "区切り文字による項目の分割",
  "classification": "col_edit",
  "description": "区切り文字により、項目を分割する",
  "url": "./static/pdf/mcmd/col_edit/msplit.pdf"
}