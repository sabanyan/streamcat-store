{
  "id": "msetstr",
  "rules": {
    "v": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$|^$",
          "message": "入力が正しくありません"
        }
      }
    },
    "a": {
      "presencesIfTargetIsNotInput": [
        "nfn",
        "nfno"
      ],
      "specifiedFormatIfTargetInput": {
        "target": "a",
        "pattern": "^[^,]+$|^$",
        "message": "入力が正しくありません。"
      },
      "lessValueListThanN": {
        "target": "v",
        "difference": "0",
        "justValue": "-1"
      }
    }
  },
  "params": [
    {
      "name": "v",
      "type": "string",
      "label": "追加する値"
    },
    {
      "name": "a",
      "type": "string",
      "label": "追加列名"
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "文字列項目の追加",
  "classification": "col_edit",
  "description": "指定した文字列を値とする項目を追加する",
  "url": "./static/pdf/mcmd/col_edit/msetstr.pdf",
  "groups": [
    {
      "name": "cmd_main",
      "label": "列追加の設定",
      "params": [
        "v",
        "a"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "nfn"
      ]
    },
    {
      "name": "fields",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "tmpPath"
      ]
    }
  ]
}