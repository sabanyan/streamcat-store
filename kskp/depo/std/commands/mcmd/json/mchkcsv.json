{
  "id": "mchkcsv",
  "params": [
    {
      "name": "a",
      "type": "string",
      "label": "入力データの項目名を無視し、ここで指定した項目名を出力",
      "optional": true
    },
    {
      "name": "diag",
      "type": "boolean",
      "label": "チェックのみ実行する。",
      "optional": true
    },
    {
      "name": "r",
      "type": "boolean",
      "label": "制御文字を無視",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "label": "入力ファイル",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "CSV検査",
  "classification": "validation",
  "description": "入力データが規定のCSV形式であるかを検査する",
  "url": "./static/pdf/mcmd/validation/mchkcsv.pdf",
  "groups": [
    {
      "name": "cmd_main",
      "label": "検査の設定",
      "params": [
        "a"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "diag",
        "r",
        "nfn"
      ]
    },
    {
      "name": "fields",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_nullout",
        "tmpPath"
      ]
    }
  ]
}