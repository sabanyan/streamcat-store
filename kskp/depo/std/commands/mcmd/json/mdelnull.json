{
  "id": "mdelnull",
  "rules": {
    "f": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$",
          "message": "一項目のみ入力してください"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "k": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[^,]+(,[^,]+)*$|^$",
          "message": "一項目のみ入力してください"
        },
        "specialRules": [
          {
            "target": [
              "x",
              "nfn"
            ],
            "pattern": "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message": "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "bufcount": {
      "specifiedFormatIfTargetInput": {
        "target": "bufcount",
        "pattern": "^[1-9]?[0-9]*$|^0$|^$",
        "message": "0以上の整数を半角で入力してください"
      }
    }
  },
  "params": [
    {
      "name": "f",
      "type": "string",
      "label": "対象列名(必須)"
    },
    {
      "name": "k",
      "type": "string",
      "label": "削除する単位となるキー列名",
      "optional": true
    },
    {
      "name": "F",
      "type": "boolean",
      "label": "項目間 AND 条件",
      "optional": true
    },
    {
      "name": "r",
      "type": "boolean",
      "label": "条件反転、削除ではなく選択",
      "optional": true
    },
    {
      "name": "R",
      "type": "boolean",
      "label": "レコード間 AND 条件",
      "optional": true
    },
    {
      "name": "bufcount",
      "type": "string",
      "label": "バッファの数",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目に NULL 値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      },
      {
        "name": "u",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "NULL値行の削除",
  "classification": "row_edit",
  "description": "指定した項目で、NULL値が含まれる行を削除する",
  "url": "./static/pdf/mcmd/row_edit/mdelnull.pdf",
  "groups": [
    {
      "name": "grouping",
      "label": "グループの設定",
      "params": [
        "k"
      ]
    },
    {
      "name": "cmd_main",
      "label": "行削除の設定",
      "params": [
        "f",
        "F",
        "bufcount"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "r",
        "R",
        "nfn",
        "q"
      ]
    },
    {
      "name": "fields",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "nfno",
        "x"
      ]
    },
    {
      "name": "system",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullkey",
        "tmpPath"
      ]
    }
  ]
}