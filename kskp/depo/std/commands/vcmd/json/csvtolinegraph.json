{
  "version": "0.7.0",
  "id": "csvtolinegraph",
  "order": 200,
  "label": "折れ線グラフ（時系列データ用）",
  "classification": "visualize",
  "description": "csvファイルから折れ線グラフを作成する",
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "params": [
    {
      "name": "x_axis",
      "type": "list",
      "elements": [
        {
          "name"  :"column",
          "type"  :"column",
          "label" :"横軸列：時間軸"
        },
        {
          "name"  :"label",
          "type"  :"string",
          "label" :"横軸名"
        }
      ],
      "default":[{"column":null, "label":""}],
      "options":{
        "visiable_button_add"  : false,
        "visiable_button_delete": false,
        "draggable" : false
      }
    },
    {
      "name": "y_axis",
      "type": "list",
      "elements": [
        {
          "name"  :"column",
          "type"  :"column",
          "label" :"縦軸列：データ"
        },
        {
          "name"  :"label",
          "type"  :"string",
          "label" :"縦軸名"
        }
      ],
      "default":[{"column":null, "label":""}],
      "options":{
        "visiable_button_add"  : false,
        "visiable_button_delete": false,
        "draggable" : false
      }
    },
    {
      "name"  :"x_axis_format_select",
      "type"  :"select",
      "label" :"横軸列：時間軸　フォーマット",
      "options":{
        "labels": ["Nysol","実数","ユーザー指定"],
        "values": ["nysol","float","custom"]
      },
      "default":"nysol"
    },
    {
      "name"  :"x_axis_format_custom",
      "type"  :"string",
      "label" :"横軸列：時間軸　フォーマット(ユーザー指定)",
      "default":"%Y%m%d%H%M%S%f",
      "description": "対象項目の日付時刻要素を、プレースホルダで置き換えた文字列を指定してください\n●プレースホルダ記号の一覧\n   日付時刻の要素 ：プレースホルダ記号 (条件）\n         年                  : %Y (西暦4桁以内),  %y(西暦2桁以内)\n         月                  : %m (2桁以内)\n         日                  : %d  (2桁以内)\n       時間                : %H  (24時間表記で2桁以内)\n         分                 : %M  (2桁以内)\n         秒                 : %S  (2桁以内) \n         マイクロ秒   : ％f \n●抽出指定の例\n   入力                              ：抽出の指定\n   yyyy-mm-dd HH:MM:SS   :%Y-%m-%d %H:%M:%S\n   yyyymmdd HHMMSS.f        :%Y%m%d %H%M%S.%f"
    },
    {
      "name": "data_column",
      "type": "column",
      "options":{
        "multiple": true
      },
      "label": "データ系列",
      "description": "データ系列を表す項目名（復数可、順序は指定不可）を指定します\n指定した項目の値（復数項目時はそれぞれの値の組合せ）を系列として設定します",
      "default": []
    },
    {
      "name": "offset",
      "type": "number",
      "label": "表示の開始（１始まりの行番号）"
    },
    {
      "name": "limit",
      "type": "number",
      "label": "表示の件数",
      "default": 100
    },
    {
      "name": "width",
      "type": "number",
      "label": "横軸（ドット）",
      "default": 1000
    },
    {
      "name": "height",
      "type": "number",
      "label": "縦軸（ドット）",
      "default": 600
    }
  ],
  "groups": [
    {
      "name": "axis_group",
      "label": "軸の設定",
      "params": ["x_axis","y_axis","x_axis_format_select","x_axis_format_custom"]
    },
    {
      "name": "data_group",
      "label": "データ系列の設定",
      "params": ["data_column"]
    },
    {
      "name": "offset_group",
      "label": "データ表示範囲の設定",
      "params": ["offset","limit"]
    },
    {
      "name": "graph_size",
      "label": "グラフサイズの設定",
      "params": ["width","height"]
    }
  ],
  "url": ""
}
