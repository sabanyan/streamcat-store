{
  "version": "0.7.0",
  "id": "csvtohistogram",
  "order": 300,
  "label": "ヒストグラム",
  "classification": "visualize",
  "description": "csvファイルからヒストグラムを作成する",
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "params": [
    {
      "name": "x_axis",
      "type": "list",
      "elements": [
        {
          "name"  :"column",
          "type"  :"column",
          "label" :"横軸列：観測値"
        },
        {
          "name"  :"label",
          "type"  :"string",
          "label" :"横軸名"
        }
      ],
      "default":[{"column": null, "label":""}],
      "options":{
        "visiable_button_add"  : false,
        "visiable_button_delete": false,
        "draggable" : false
      }
    },
    {
      "name": "data_column",
      "type": "column",
      "options":{
        "multiple": true
      },
      "label": "データ系列",
      "description": "データ系列を表す項目名（復数可、順序は指定不可）を指定します\n指定した項目の値（復数項目時はそれぞれの値の組合せ）を系列として設定します"
    },
    {
      "name": "offset",
      "type": "number",
      "label": "表示の開始（１始まりの行番号）"
    },
    {
      "name": "limit",
      "type": "number",
      "label": "表示の件数",
      "default": 100
    },
    {
      "name": "bins",
      "type": "number",
      "label": "ビンの数",
      "default": 20
    },
    {
      "name": "width",
      "type": "number",
      "label": "横幅（ドット）",
      "default": 1000
    },
    {
      "name": "height",
      "type": "number",
      "label": "縦幅（ドット）",
      "default": 600
    }
  ],
  "groups": [
      {
        "name": "axis_group",
        "label": "軸の設定",
        "params": ["x_axis"]
      },
      {
        "name": "data_group",
        "label": "データ系列の設定",
        "params": ["data_column"]
      },
      {
        "name": "offset_group",
        "label": "データ表示範囲の設定",
        "params": ["offset","limit"]
      },
      {
        "name": "graph_group",
        "label": "グラフ表示要素の設定",
        "params": ["bins"]
      },
      {
        "name": "graph_size",
        "label": "グラフサイズの設定",
        "params": ["width","height"]
      }
  ],
  "url": ""
}
