{
  "id": "multi_mcal_oneformula",
  "groups": [
    {
      "name": "group1",
      "label": "計算式の設定（必須）",
      "params": [
        "targets",
        "a",
        "c"
      ]
    },
    {
      "name": "group2",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": [
        "x",
        "nfn",
        "nfno"
      ]
    },
    {
      "name": "group3",
      "label": "その他（省略可）",
      "params": [
        "precision"
      ]
    },
    {
      "name": "group4",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "tmpPath",
        "assert_diffSize",
        "assert_nullout"
      ]
    }
  ],
  "rules": {
    "targets": {
      "presence": {
        "allowEmpty": false
      }
    },
    "a": {
      "presence": {
        "allowEmpty": false
      }
    },
    "c": {
      "presence": {
        "allowEmpty": false
      }
    }
  },
  "params": [
    {
      "name": "targets",
      "type": "string",
      "label": "対象とする項目",
      "description": "項目名時:*,？,[...] 使用可\n項目番号時:0−3,5,0L 等使用可"
    },
    {
      "name": "a",
      "type": "string",
      "label": "追加する項目名",
      "description": "&:元の項目名を表す記号",
      "default": "new_&"
    },
    {
      "name": "c",
      "type": "string",
      "label": "計算式",
      "description": "●項目の値、数値、文字列、時刻に対する演算子と関数が100種以上とif文による制御を組み合わせた計算が可能\n●値の参照\n  ${項目名}で当行参照、#{項目名}で前行参照が可能\n●型の指定\n  数値：${}, 文字列:$s{}, 時刻:$t{}, 日付:$d{}, 論理:$b{}\n●対象とする項目は${&}で指定",
      "default": "${&}"
    },
    {
      "name": "precision",
      "type": "string",
      "label": "有効桁数",
      "description": "1〜16の整数",
      "optional": true,
      "default": 10
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "複数項目の計算 (共通式)",
  "classification": "calculation",
  "description": "同一の式を、複数の項目に適用し、複数の結果を追加する",
  "url": "./static/pdf/mcmd/calculation/mcal.pdf"
}