{
  "id": "hex2bin",
  "rules" : {
    "hex": {
      "presence": {"allowEmpty": false},
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+$|^$",
          "message" : "1項目のみ入力してください"
        }
    }
    },
    "f" : {
      "presence": {"allowEmpty": false},
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,:]+(:[^,:]+)?(,[^,:]+(:[^,:]+)?)*$",
          "message" : "入力値が正しくありません。"
        }
      }
    }
  },
  "params": [
    {
      "name": "hex",
      "type": "string",
      "label": "16進数項目名"
    },
    {
      "name": "f",
      "type": "string",
      "label": "抽出する項目名リスト"
    },
    {
      "name": "comp",
      "type": "boolean",
      "label": "項目名定義がユニークで、桁数と項目数が完全一致のものを抽出し、それ以外をNullとする",
      "default": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      },
      {
        "name": "m",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.3.0",
  "label": "項目名による16進数ビット列抽出",
  "classification": "value_transform",
  "description": "16進数項目をビット列に変換し、mの項目名と照合して、指定列を抽出する。（異常値はNullに置換される。）",
  "url": ""
}