{
  "id": "plaintext2csv",
  "rules": {
    "field": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[1-9].[0-9]*$|^[1-9]$|^@\\[.+\\]$|^$",
          "message": "1以上の整数を半角で入力してください"
        }
      }
    },
    "attr": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[1-9][0-9]*$|^[1-9][0-9]*-[1-9][0-9]*$",
          "message": "行番号の指定は、1以上の整数で、範囲を指定する場合は−(ハイフン）区切りで入力してください"
        }
      }
    },
    "observe": {
      "presence": {
        "allowEmpty": false
      },
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[1-9].[0-9]*$|^[1-9]$|^@\\[.+\\]$|^$",
          "message": "1以上の整数を半角で入力してください"
        }
      },
      "compareNumbersLargerThan": {
        "target": "field",
        "message": "観測値は列名行より下に設定してください"
      }
    },
    "except_chr": {
      "onlyOneInput": {
        "target": [
          "except_null"
        ]
      }
    },
    "except_null": {
      "onlyOneInput": {
        "target": [
          "except_chr"
        ]
      }
    },
    "except_end_chr": {
      "onlyOneInput": {
        "target": [
          "except_end_range",
          "except_end_null"
        ]
      }
    },
    "except_end_range": {
      "checkSeveralSpecifiedFormats": {
        "defaultRule": {
          "pattern": "^[1-9].[0-9]*$|^[1-9]$|^@\\[.+\\]$|^$",
          "message": "1以上の整数を半角で入力してください"
        }
      },
      "onlyOneInput": {
        "target": [
          "except_end_chr",
          "except_end_null"
        ]
      }
    },
    "except_end_null": {
      "onlyOneInput": {
        "target": [
          "except_end_chr",
          "except_end_range"
        ]
      }
    }
  },
  "params": [
    {
      "name": "field",
      "type": "string",
      "label": "項目名行の指定 (必須)",
      "description": "1始まりの行番号で、１行のみ指定する"
    },
    {
      "name": "attr",
      "type": "string",
      "label": "属性の行範囲の指定(未実装)",
      "description": "1始まりの行番号で、ハイフン(-)区切りで指定する(例:1-2)"
    },
    {
      "name": "observe",
      "type": "string",
      "label": "観測値の開始行 (必須)",
      "description": "1始まりの行番号で指定する"
    },
    {
      "name": "except_chr",
      "type": "string",
      "label": "正規表現で指定"
    },
    {
      "name": "except_end_chr",
      "type": "string",
      "label": "正規表現で指定"
    },
    {
      "name": "except_end_range",
      "type": "string",
      "label": "開始からの行数"
    },
    {
      "name": "except_null",
      "type": "boolean",
      "label": "空の行で終了する"
    },
    {
      "name": "except_end_null",
      "type": "boolean",
      "label": "空の行で開始する"
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.3",
  "label": "CSVデータの抽出",
  "classification": "data_format",
  "description": "不完全なCSVから、不要部分を除きCSV領域のみ出力する",
  "url": "",
  "groups": [
    {
      "name": "cmd_main",
      "label": "行選択の設定 (必須)",
      "params": [
        "field",
        "observe"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "除外範囲の設定 (省略可)",
      "description": "開始と終了の行条件に合う範囲を除外します。マッチする範囲が複数回ある場合は、全て除外されます。",
      "params": []
    },
    {
      "name": "cmd_sub_1",
      "label": "開始条件",
      "description": "正規表現または空の行、どちらかで指定してください",
      "params": [
        "except_chr",
        "except_null"
      ]
    },
    {
      "name": "cmd_sub_２",
      "label": "終了条件",
      "description": "開始からの行数、正規表現または空の行、いずれか１つで指定してください",
      "params": [
        "except_end_range",
        "except_end_chr",
        "except_end_null"
      ]
    },
    {
      "name": "cmd_sub2",
      "label": "その他 (省略可)",
      "params": [
        "attr"
      ]
    }
  ]
}