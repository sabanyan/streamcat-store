{
  "version": "0.7.0",
  "id": "column_list",
  "label": "項目名リストの取得",
  "classification": "col_edit",
  "description": "指定した行数だけ、項目名と値を行方向へ展開した縦型データで出力する",
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "params": [
    {
      "name": "n",
      "type": "string",
      "label": "出力したいデータの行数を指定する。最大100行まで出力可能、デフォルトは0件で先頭行のみ。100行以上を指定した場合、100行までを出力"
    },
    {
      "name": "no",
      "type": "boolean",
      "label": "出力データの先頭列に連番を出力する"
    },
    {
      "name": "-nfno",
      "type": "boolean",
      "label": "出力データの項目名行を出力しない"
    }
  ],
  "url": "",
  "groups": [
    {
      "name": "cmd_sub",
      "label": "その他 (省略可)",
      "params": [
        "n",
        "no"
      ]
    },
    {
      "name": "その他 (省略可)",
      "label": "cmd_sub",
      "params": [
        "-nfno"
      ]
    }
  ]
}