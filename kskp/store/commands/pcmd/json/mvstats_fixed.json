{
  "id": "mvstats_fixed",
  "groups": [
    {
      "name": "group1",
      "label": "対象列の設定",
      "params": ["s", "s_num", "s_desc", "k", "faclist"]
    },
    {
      "name": "group2",
      "label": "計算の共通設定",
      "params": ["t"]
    },
    {
      "name": "group3",
      "label": "列名・項目番号についての設定",
      "params": ["x", "nfn", "nfno"]
    },
    {
      "name": "group4",
      "label": "その他",
      "params": ["precision", "tmpPath"]
    },
    {
      "name": "group5",
      "label": "システム管理用設定（ログ出力）",
      "params": ["assert_diffSize", "assert_nullkey", "assert_nullin",
        "assert_nullout"]
    }
  ],  
  "params": [
    {
      "name": "s",
      "type": "string",
      "label" : "Field to sort",
      "default": ""
    },
    {
      "name": "s_num",
      "type": "boolean",
      "label" : "Sort field as numbers",
      "optional": true
    },
    {
      "name": "s_desc",
      "type": "boolean",
      "label" : "Sort in descending order",
      "optional": true
    },
    {
      "name": "k",
      "type": "string",
      "label": "key field"
    },
    {
      "name": "faclist",
      "type": "list",
      "label": "移動平均対象列名と結果列名",
      "elements": [
        {
          "name": "f",
          "type": "string",
          "label": "対象列名"
        },
        {
          "name": "a",
          "type": "string",
          "label": "結果列名"
        },
        {
          "name": "c",
          "type": "string",
          "label": "統計量 *probably best if this is a dropdown"
        }
      ],
      "default": [{"f": "", "a": "", "c": ""}]
    },
    {
      "name": "t",
      "type": "string",
      "label": "期間数",
      "default": 5
    },
    {
      "name": "precision",
      "type": "string",
      "label": "有効桁数",
      "optional": true,
      "default": 10
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目にNULL値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "移動窓の統計量の計算_fixedinterval",
  "classification": "calculation",
  "description": "移動窓を設定し、各種統計量(1変量)を計算する。",
  "url": "./static/pdf/mcmd/calculation/mcal.pdf"
}
