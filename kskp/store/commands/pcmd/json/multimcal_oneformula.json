{
  "id": "multimcal_oneformula",
  "groups": [
    {
      "name": "group1",
      "label": "計算式の設定",
      "params": ["targets", "a", "c"]
    },
    {
      "name": "group2",
      "label": "列名・項目番号についての設定",
      "params": ["x", "nfn", "nfno"]
    },
    {
      "name": "group3",
      "label": "その他",
      "params": ["precision", "tmpPath"]
    },
    {
      "name": "group4",
      "label": "システム管理用設定（ログ出力）",
      "params": ["assert_diffSize", "assert_nullout"]
    }
  ],  
  "rules": {
    "targets": {
      "presence": {"allowEmpty": false}
    },
    "a": {
      "presence": {"allowEmpty": false}
    },
    "c": {
      "presence": {"allowEmpty": false}
    }
  },
  "params": [
    {
      "name": "targets",
      "type": "string",
      "label" : "対象とする列",
      "description" : "列名時:*,？,[...] 使用可\n項目番号時:0−3,5,0L 等使用可"
    },
    {
      "name": "a",
      "type": "string",
      "label": "追加する列名",
      "description": "&:元の列名を表す記号",
      "default": "new_&" 
    },
    {
      "name": "c",
      "type": "string",
      "label": "計算式",
      "description": "&:対象とする列の値を表す記号（${&},#{&}）可",
      "default": "${&}"
    },
    {
      "name": "precision",
      "type": "string",
      "label": "有効桁数",
      "optional": true,
      "default": 10
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "複数列計算（共通式）",
  "classification": "calculation",
  "description": "複数列の計算を、同一の式を全ての列に適用して行う。",
  "url": "./static/pdf/mcmd/calculation/mcal.pdf"
}
