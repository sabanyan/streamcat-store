{
  "id": "mvavg_fixed",
  "rules": {
    "f":{
      "presence": {"allowEmpty": false}
    }
  },
  "groups": [
    {
      "name": "group1",
      "label": "キー項目の設定（省略可）",
      "params": ["k"]
    },
    {
      "name": "group2",
      "label": "時系列の設定（省略可）",
      "params": ["s", "s_num", "s_desc"]
    },
    {
      "name": "group3",
      "label": "計算対象列と追加列名の設定（必須）",
      "params": ["f", "a"]
    },
    {
      "name": "group4",
      "label": "計算の共通設定",
      "params": ["type", "alpha", "t"]
    },
    {
      "name": "group5",
      "label": "列名・項目番号についての設定",
      "params": ["x", "nfn", "nfno"]
    },
    {
      "name": "group6",
      "label": "その他",
      "params": ["precision", "tmpPath"]
    },
    {
      "name": "group7",
      "label": "システム管理用設定（ログ出力）",
      "params": ["assert_diffSize", "assert_nullkey", "assert_nullin",
        "assert_nullout"]
    }
  ],  
  "params": [
    {
      "name": "s",
      "type": "string",
      "label" : "ソートする列（カンマ区切りで複数指定可）"
    },    
    {
      "name": "s_num",
      "type": "boolean",
      "label" : "文字列ではなく、数値としてソートする",
      "default": false,
      "optional": true
    },
    {
      "name": "s_desc",
      "type": "boolean",
      "label" : "昇順ではなく、降順でソートする",
      "default": false,
      "optional": true
    },
    {
      "name": "k",
      "type": "string",
      "label": "グループ化する列（カンマ区切りで複数指定可）"
    },    
    {
      "name": "f",
      "type": "string",
      "label": "対象列名（列名時:*,？,[...] 使用可）（項目番号時:0−3,5,0L 等使用可）"
    },
    {
      "name": "a",
      "type": "string",
      "label": "結果列名（&:元の列名を表す記号）"
    },
    {
      "name": "t",
      "type": "string",
      "label": "期間数（１以上の整数）",
      "default": 5
    },
    {
      "name": "type",
      "type": "select",
      "label": "移動平均手法の選択",
      "options":{
        "labels": ["単純移動平均(SMA)","線形荷重移動平均(WMA)","指数平滑移動平均(EMA)"],
        "values": ["simple","w","exp"]
      },
      "default": "simple"
    },
    {
      "name": "alpha",
      "type": "string",
      "label": "指数平滑手法時の平滑化係数α",
      "default": "",
      "optional": true
    },
    {
      "name": "precision",
      "type": "string",
      "label": "有効桁数",
      "optional": true,
      "default": 10
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目にNULL値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "移動平均_fixedinterval",
  "classification": "calculation",
  "description": "複数列の計算を、同一の式を全ての列に適用して行う。",
  "url": "./static/pdf/mcmd/calculation/mcal.pdf"
}
