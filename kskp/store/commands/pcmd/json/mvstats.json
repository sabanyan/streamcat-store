{
  "id": "mvstats",
  "groups": [
    {
      "name": "group1",
      "label": "対象列の設定",
      "params": ["s","s_num", "k", "f", "a", "q"]
    },
    {
      "name": "group2",
      "label": "計算の設定",
      "params": ["c","t"]
    },
    {
      "name": "group3",
      "label": "列名・項目番号についての設定",
      "params": ["x", "nfn", "nfno"]
    },
    {
      "name": "group4",
      "label": "その他",
      "params": ["precision", "tmpPath"]
    },
    {
      "name": "group5",
      "label": "システム管理用設定（ログ出力）",
      "params": ["assert_diffSize", "assert_nullkey", "assert_nullin",
        "assert_nullout"]
    }
  ],  
  "params": [
    {
      "name": "s",
      "type": "string",
      "label" : "Field to sort"
    },
    {
      "name": "s_num",
      "type": "boolean",
      "label": "sort as numbers",
      "default": true
    },
    {
      "name": "k",
      "type": "string",
      "label": "key field"
    },
    {
      "name": "f",
      "type": "string",
      "label": "移動平均を求める項目名リスト"
    },
    {
      "name": "a",
      "type": "string",
      "label": "results field name"
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "c",
      "type": "select",
      "label": "統計量を指定",
      "options":{
        "labels": ["合計","算術平均","偏差平方和","分散","分散(不偏推定値)","標準偏差",
          "標準偏差(不偏分散のsqrt)","変動係数","最小値","最大値","範囲", "歪度",
          "歪度 (不偏推定値)","尖度","尖度 (不偏推定値)"],
        "values": ["sum","mean","devsq","var","uvar","sd","usd","cv","min",
          "max","range","skew","uskew","kurt","ukurt"]
      },
      "default": "sum"
    },
    {
      "name": "t",
      "type": "string",
      "label": "Interval > 1",
      "default": 5
    },
    {
      "name": "precision",
      "type": "string",
      "label": "有効桁数",
      "optional": true,
      "default": 10
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目にNULL値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "移動窓の統計量の計算",
  "classification": "calculation",
  "description": "移動窓を設定し、各種統計量(1変量)を計算する。",
  "url": "./static/pdf/mcmd/calculation/mcal.pdf"
}
