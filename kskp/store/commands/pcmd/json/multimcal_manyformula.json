{
  "id": "multimcal_manyformula",
  "groups": [
    {
      "name": "group1",
      "label": "計算式の設定",
      "params": ["arglist"]
    },
    {
      "name": "group2",
      "label": "列名・項目番号についての設定",
      "params": ["x", "nfn", "nfno"]
    },
    {
      "name": "group3",
      "label": "その他",
      "params": ["precision", "tmpPath"]
    },
    {
      "name": "group4",
      "label": "システム管理用設定（ログ出力）",
      "params": ["assert_diffSize", "assert_nullout"]
    }
  ],
  "params": [
    {
      "name": "arglist",
      "type": "list",
      "label": "列名と計算式（追加・順序変更・削除　可）",
      "elements": [
        {
          "name": "a",
          "type": "string",
          "label": "列名(必須)"
        },
        {
          "name": "c",
          "type": "string",
          "label": "計算式(必須)"
        }
      ],
      "default": [{"a": "", "c": ""}]
    },
    {
      "name": "precision",
      "type": "string",
      "label": "有効桁数",
      "optional": true,
      "default": 10
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "複数列計算（個別式）",
  "classification": "calculation",
  "description": "一つのコマンドで複数列計算。計算ごとにcとaオプションを入力する。",
  "url": "./static/pdf/mcmd/calculation/mcal.pdf"
}
