{
  "version": "0.7.0",
  "id": "csvtolinegraph",
  "order": 200,
  "label": "折れ線グラフ（時系列データ用）",
  "classification": "visualize",
  "description": "csvファイルから折れ線グラフを作成する",
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "params": [
    {
      "name": "time_series_column",
      "type": "column",
      "options":{
        "multiple": true
      },
      "label": "時系列データの列を指定する。"
    },
    {
      "name": "x_axis_column",
      "type": "column",
      "options":{
        "multiple": false
      },
      "label": "x軸に表示する項目"
    },
    {
      "name": "y_axis_column",
      "type": "column",
      "options":{
        "multiple": false
      },
      "label": "y軸に表示する項目"
    },
    {
      "name": "data_column",
      "type": "column",
      "options":{
        "multiple": false
      },
      "label": "キー項目列名"
    },
    {
      "name": "offset",
      "type": "number",
      "label": "ビジュアライズを行う開始行"
    },
    {
      "name": "alpha",
      "type": "number",
      "label": "透明度",
      "default": 1
    },
    {
      "name": "limit",
      "type": "number",
      "label": "ビジュアライズ対象のデータ数",
      "default": 1000
    },
    {
      "name": "x_size",
      "type": "number",
      "label": "ビジュアライズの横サイズ",
      "default": 1000
    },
    {
      "name": "y_size",
      "type": "number",
      "label": "ビジュアライズの縦サイズ",
      "default": 600
    },
    {
      "name": "graph_title",
      "type": "string",
      "label": "ビジュアライズのタイトル"
    },
    {
      "name": "x_label",
      "type": "string",
      "label": "x軸のラベル"
    },
    {
      "name": "y_label",
      "type": "string",
      "label": "y軸のラベル"
    }
  ],
  "url": ""
}
