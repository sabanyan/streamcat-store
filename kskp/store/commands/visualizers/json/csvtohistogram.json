{
  "version": "0.7.0",
  "id": "csvtohistogram",
  "order": 300,
  "label": "ヒストグラム",
  "classification": "visualize",
  "description": "csvファイルからヒストグラムを作成する",
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "params": [
    {
      "name": "x_axis",
      "type": "column",
      "options":{
        "multiple": false
      },
      "label": "x軸に表示する項目"
    },
    {
      "name": "data_column",
      "type": "column",
      "options":{
        "multiple": false
      },
      "label": "キー項目列名"
    },
    {
      "name": "bins",
      "type": "number",
      "label": "ビンの幅",
      "default": 20
    },
    {
      "name": "offset",
      "type": "number",
      "label": "ビジュアライズを行う開始行"
    },
    {
      "name": "limit",
      "type": "number",
      "label": "ビジュアライズ対象のデータ数",
      "default": 100
    },
    {
      "name": "x_size",
      "type": "number",
      "label": "ビジュアライズの横サイズ",
      "default": 1000
    },
    {
      "name": "y_size",
      "type": "number",
      "label": "ビジュアライズの縦サイズ",
      "default": 600
    },
    {
      "name": "graph_title",
      "type": "string",
      "label": "ビジュアライズのタイトル"
    },
    {
      "name": "x_label",
      "type": "string",
      "label": "x軸のラベル"
    },
    {
      "name": "y_label",
      "type": "string",
      "label": "y軸のラベル"
    },
    {
      "name": "alpha",
      "type": "number",
      "label": "透明度",
      "default": 1
    }
  ],
  "url": ""
}
