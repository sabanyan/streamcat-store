{
  "id": "msim",
  "rules":{
    "c" : {
      "presence": {"allowEmpty": false}
    },
    "f" : {
      "presence": {"allowEmpty": false},
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+(,[^,]+)+$",
          "message" : "2つ以上の項目を指定してください"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "a" : {
      "format" : {
        "pattern" : "^[^,]+,[^,]+$|^$|^@\\[.+\\]$", 
        "message" : "対象となる列名を2つ入力してください"
      }
    },
    "bufcount" : {
      "specifiedFormatIfTargetInput" : {
        "target" : "bufcount",
        "pattern": "^[1-9]?[0-9]*$|^0$|^$",
        "message": "0以上の整数を半角で入力してください"
      }
    }
  },
  "params": [
    {
      "name": "c",
      "type": "select",
      "label": "類似度名を指定",
      "options":{
        "multiple": true,
        "labels": ["共分散","普偏共分散","ピアソンの積率相関係数","スピアマンの順位相関係数","ケンドールの順位相関係数","ユークリッド距離(数値)","コサイン","都市ブロック距離","ハミング距離","カイ2乗値","ファイ係数","ジャックカード係数","支持度","リフト値","最大確信度","最小確信度","yuleの連関係数(Q)","yuleの連関係数(Y)","kappa","oddsRatio","最大conviction","最小conviction"],
        "values": ["covar","ucovar","pearson","spearman","kendall","euclid","cosine","cityblock","hamming","chi","phi","jaccard","support","lift","confMax","confMin","yuleQ","yuleY","kappa","oddsRatio","convMax","convMin"]
      }
    },
    {
      "name": "f",
      "type": "string",
      "label": "二列間の類似度を求める列名(必須)"
    },
    {
      "name": "a",
      "type": "string",
      "label": "二変数の名前の指定",
      "optional": true,
      "default": "fld1,fld2"
    },
    {
      "name": "k",
      "type": "string",
      "label": "単位とする列名",
      "optional": true
    },
    {
      "name": "n",
      "type": "boolean",
      "label": "Null データの場合はNULLにするフラグ",
      "optional": true
    },
    {
      "name": "d",
      "type": "boolean",
      "label": "対角行列、上三角行列を出力する。",
      "optional": true
    },
    {
      "name": "bufcount",
      "type": "string",
      "label": "バッファの数",
      "optional": true,
      "default": 10
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目にNULL値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=またはvf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "二変数間の類似度の計算",
  "classification": "table_grouping",
  "description": "f=で指定した項目の二変数間の類似度(距離)をc=で指定した類似度(距離)関数で計算し、類似度行列として出力する。",
  "url": "./static/pdf/mcmd/table_grouping/msim.pdf"
}