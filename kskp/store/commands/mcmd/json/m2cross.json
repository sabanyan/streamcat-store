{
  "id": "m2cross",
  "groups": [
    {
      "name": "group1",
      "label": "グループの設定 (省略可)",
      "params": ["k"]
    },
    {
      "name": "group2",
      "label": "グループ内のソートの設定（省略可)",
      "params": ["s"]
    },
    {
      "name": "group5",
      "label": "〇〇の設定 (必須)",
      "params": ["v", "a","f"]
    },

    {
      "name": "group10",
      "label": "その他 (省略可)",
      "params": ["q"]
    },
    {
      "name": "group15",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": ["x", "nfn", "nfno"]
    },
    {
      "name": "group20",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": ["tmpPath", "assert_diffSize", "assert_nullout", "assert_nullkey","assert_nullin"]
    }
  ],
  "rules":{
    "f":{
      "presence": {"allowEmpty": false},
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+$",
          "message" : "一項目のみ入力してください"
        },
        "specialRules" : [
          {
            "target" : "a",
            "pattern" : "^[^,]+(,[^,]+)*$",
            "message" : "複数項目入力時は,(コンマ)で区切ってください",
            "looserPatternThanDefault" : true
          },
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "a":{
      "presencesIfTargetIsNotInput": ["s"],
      "format" : {
        "pattern" : "^[^,]+,[^,]+$|^$",
        "message" : "2項目入力してください"
      }
    },
    "s":{
      "presencesIfTargetIsNotInput": ["a"],
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+$|^$",
          "message" : "一項目のみ入力してください"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*|^@\\[.+\\]$|^$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "k" : {
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+(,[^,]+)*$|^$",
          "message" : "入力値が正しくありません。"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    }
  },
  "params": [
    {
      "name": "f",
      "type": "string",
      "label": "組み合わせ列名(必須)"
    },
    {
      "name": "s",
      "type": "string",
      "label": "列項目名に展開する列(aとどちらか必須)"
    },
    {
      "name": "a",
      "type": "string",
      "label": "２項目指定(sとどちらか必須)"
    },
    {
      "name": "k",
      "type": "string",
      "label": "グループ化する項目名",
      "description": "●カンマ区切りで複数指定可",
      "optional": true
    },
    {
      "name": "v",
      "type": "string",
      "label": "NULL値置換文字列",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目に NULL 値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目の f=または vf=で指定された項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "description": "入力データがグループ単位でソート済みの場合、指定すると処理速度が向上",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "1対Nのクロス集計",
  "classification": "value_crossing",
  "description": "行から列へ、もしくは列から行への展開のどちらかを行う",
  "url": "./static/pdf/mcmd/value_crossing/m2cross.pdf"
}