{
  "id": "mselnum",
  "groups": [
    {
      "name": "group1",
      "label": "グループの設定(必須)",
      "params": ["k"]
    },
    {
      "name": "group2",
      "label": "条件式の設定（必須）",
      "params": ["c"]
    },
    {
        "name": "group3",
        "label": "Group3",
        "params": ["f"]
    },
    {
      "name": "group10",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": ["x", "nfn", "nfno"]
    },
    {
      "name": "group11",
      "label": "その他（省略可）",
      "params": ["q", "r", "F", "R"]
    },
    {
      "name": "group20",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [ "tmpPath", "assert_diffSize", "assert_nullkey","assert_nullin", "bufcount"]
    }
  ],
  "rules" : {
    "f" :{
      "presence": {"allowEmpty": false},
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+(,[^,]+)*$",
          "message" : "入力が正しくありません"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "c" : {
      "presence": {"allowEmpty": false},
      "format" : {
        "pattern" : "^(\\[)?([1-9]?[0-9]+)?,([1-9]?[0-9]+)?(\\])?(,(\\[)?([1-9]?[0-9]+)?,([1-9]?[0-9]+)?(\\])?)*$",
        "message" : "数値の範囲はリスト形式で指定してください"
      }
    },
    "k" : {
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+(,[^,]+)*$|^$",
          "message" : "入力が正しくありません"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "bufcount" : {
      "specifiedFormatIfTargetInput" : {
        "target" : "bufcount",
        "pattern": "^[1-9]?[0-9]*$|^0$|^$",
        "message": "0以上の整数を半角で入力してください"
      }
    }
  },
  "params": [
    {
      "name": "f",
      "type": "string",
      "label": "検索列名(必須)"
    },
    {
      "name": "c",
      "type": "string",
      "label": "検索文字列(必須)"
    },
    {
      "name": "k",
      "type": "string",
      "label": "選択単位となるキー列名",
      "optional": true
    },
    {
      "name": "F",
      "type": "boolean",
      "label": "f=パラメータで複数項目を指定した場合、その全ての値がマッチする行を撰択する。",
      "optional": true
    },
    {
      "name": "r",
      "type": "boolean",
      "label": "選択ではなく削除する。",
      "optional": true
    },
    {
      "name": "R",
      "type": "boolean",
      "label": "k=パラメータを指定した場合、その全ての行がマッチすれば行を撰択する。",
      "optional": true
    },
    {
      "name": "bufcount",
      "type": "string",
      "label": "バッファの数",
      "optional": true,
      "default": 10
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目にNULL値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=またはvf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      },
      {
        "name": "u",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "数値範囲による行選択",
  "classification": "row_edit",
  "description": "f=で指定した項目の値が、c=で指定した数値範囲にマッチする行を選択する。",
  "url": "./static/pdf/mcmd/row_edit/mselnum.pdf"
}