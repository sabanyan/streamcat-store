{
  "id": "mcal",
  "groups": [
    {
      "name": "group1",
      "label": "計算式の設定（必須）",
      "params": ["a","c"]
    },
    {
      "name": "group2",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": ["x", "nfn", "nfno"]
    },
    {
      "name": "group3",
      "label": "その他（省略可）",
      "params": ["precision"]
    },
    {
      "name": "group4",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [ "tmpPath", "assert_diffSize", "assert_nullout"]
    }
  ],
  "rules": {
    "a": {
      "presence": {"allowEmpty": false}
    },
    "c": {
      "presence": {"allowEmpty": false}
    }
  },
  "params": [
    {
      "name": "a",
      "type": "string",
      "label": "追加する項目名"
    },
    {
      "name": "c",
      "type": "string",
      "label": "計算式",
      "description": "●項目の値、演算子、関数(100種以上)、if文を用いた計算が可能\n●値の参照\n  ${項目名}で当行参照、#{項目名}で前行参照が可能"
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    },
    {
      "name": "precision",
      "type": "string",
      "label": "有効桁数",
      "optional": true,
      "default": 10
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "計算",
  "classification": "calculation",
  "description": "列項目間の演算を行う",
  "url": "./static/pdf/mcmd/calculation/mcal.pdf"
}
