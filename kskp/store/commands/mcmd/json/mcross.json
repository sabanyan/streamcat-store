{
  "id": "mcross",
  "rules" : {
    "f" : {
      "presence": {"allowEmpty": false},
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+(,[^,]+)*$",
          "message" : "入力値が正しくありません。"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "s" : {
      "presence": {"allowEmpty": false},
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+(,[^,]+)*$",
          "message" : "入力値が正しくありません。"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+(-[1-9]?[0-9]+)?(%n|%r|%nr)?(,[1-9]?[0-9]+(-[1-9]?[0-9]+)?(%n|%r|%nr)?)*$|^@\\[.+\\](%n|%r|%nr)?$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "a" : {
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+(,[^,]+)*$|^$",
          "message" : "入力値が正しくありません。"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "k" : {
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+(,[^,]+)*$|^$",
          "message" : "入力値が正しくありません。"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    }
  },
  "params": [
    {
      "name": "f",
      "type": "string",
      "label": "指定列の値(必須)"
    },
    {
      "name": "s",
      "type": "string",
      "label": "列名となる元のデータ列(必須)"
    },
    {
      "name": "a",
      "type": "string",
      "label": "f=で指定した列名がデータとして展開する列名",
      "optional": true
    },
    {
      "name": "k",
      "type": "string",
      "label": "キー列名",
      "optional": true
    },
    {
      "name": "v",
      "type": "string",
      "label": "NULL値置換文字列",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目に NULL 値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目の f=または vf=で指定された項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "-assert nullout 出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "クロス集計",
  "classification": "value_crossing",
  "description": "s=で指定した項目値が項目名となるよう横に展開、k=で指定した値がidとなり、f=で指定した項目がセルに出力される。",
  "url": "./static/pdf/mcmd/value_crossing/mcross.pdf"
}