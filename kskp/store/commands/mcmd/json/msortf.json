{
  "id": "msortf",
  "rules":{
    "f" : {
      "presence": {"allowEmpty": false},
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+(%n|%r|%nr)?(,[^,]+(%n|%r|%nr)?)*$",
          "message" : "入力が正しくありません"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(%n|%r|%nr)?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(%n|%r|%nr)?)*$|^@\\[.+\\](%n|%r|%nr)?$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "pways":{
      "specifiedFormatIfTargetInput" : {
        "target" : "pways",
        "pattern": "^[2-9]$|^[1-9].[0-9]$|^100$|^$|^@\\[.+\\]$",
        "message": "2から100までの整数を半角で入力してください"
      }
    },
    "blocks":{
      "specifiedFormatIfTargetInput" : {
        "target" : "blocks",
        "pattern": "^[1-9]$|^[1-9].[0-9]{0,1}$|^1000$|^$|^@\\[.+\\]$",
        "message": "1から1000までの整数を半角で入力してください"
      }
    },
    "maxlines":{
      "specifiedFormatIfTargetInput" : {
        "target" : "maxlines",
        "pattern": "^100$|^[1-9].[0-9]{2,6}$|^10000000$|^$|^@\\[.+\\]$",
        "message": "100から1000万までの整数を半角で入力してください"
      }
    },
    "threadCnt":{
      "specifiedFormatIfTargetInput" : {
        "target" : "threadCnt",
        "pattern": "^[1-9]$|^[4-9]?[0-9]$|^50$|^$|^@\\[.+\\]$",
        "message": "1から50までの整数を半角で入力してください"
      }
    }
  },
  "params": [
    {
      "name": "f",
      "type": "string",
      "label": "対象列名(必須)"
    },
    {
      "name": "pways",
      "type": "string",
      "label": "分割ソートされた複数のファイルを同時に何個併合するかを指定する。",
      "optional": true,
      "default": 32
    },
    {
      "name": "maxlines",
      "type": "string",
      "label": "メモリ内でソートする際の件数の上限を指定する。",
      "optional": true,
      "default": 500000
    },
    {
      "name": "blocks",
      "type": "string",
      "label": "メモリ内でソートする際のメモリサイズ上限をブロックサイズで指定する。",
      "optional": true,
      "default": 10
    },
    {
      "name": "threadCnt",
      "type": "string",
      "label": "分割ソートする際に、マルチスレッドの機能を用いて同時にソートする数を指定する。",
      "optional": true,
      "default": 8
    },
    {
      "name": "noflg",
      "type": "boolean",
      "label": "出力 CSV のヘッダーにソーティングの印 (%0,%0n など) を付けない。",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "レコードの並び替え",
  "classification": "row_sort",
  "description": "f=で指定した項目を基準として、クイックソートを用いてレコードを並び替える。",
  "url": "./static/pdf/mcmd/row_sort/msortf.pdf"
}
