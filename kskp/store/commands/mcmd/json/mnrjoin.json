{
  "id": "mnrjoin",
  "groups": [
    {
      "name": "group3",
      "label": "範囲の設定",
      "params": ["rf", "R"]
    },
    {
      "name": "group1",
      "label": "結合キーの設定 (省略可)",
      "params": ["k", "K"]
    },
    {
      "name": "group5",
      "label": "結合方法の設定  (省略時は 共通部分を出力)",
      "params": ["n","N"]
    },
    {
      "name": "group3",
      "label": "結合する項目の設定",
      "params": ["f"]
    },
    {
      "name": "group10",
      "label": "その他 (省略可)",
      "params": ["q"]
    },
    {
      "name": "group15",
      "label": "項目名・項目番号についての設定（省略可）",
      "params": ["x", "nfn", "nfno"]
    },
    {
      "name": "group20",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": ["tmpPath", "assert_diffSize", "assert_nullout", "assert_nullkey","assert_nullin"]
    }
  ],
  "rules" : {
    "f" : {
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+(,[^,]+)*$|^$",
          "message" : "入力が正しくありません"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "R" : {
      "presence": {"allowEmpty": false},
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+,[^,]+$|^@\\[.+\\]$",
          "message" : "項目名は２つかつ,(コンマ)で指定してください。"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?,[1-9]?[0-9]+L?$|^@\\[.+\\]$",
            "message" : "項目名は２つかつ,(コンマ)で指定してください。"
          }
        ]
      }
    },
    "rf" : {
      "presence": {"allowEmpty": false},
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+(,[^,]+)*$",
          "message" : "入力が正しくありません"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "k" : {
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+(,[^,]+)*$|^$",
          "message" : "入力が正しくありません"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "K" : {
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+(,[^,]+)*$|^$",
          "message" : "入力が正しくありません"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    }
  },
  "params": [
    {
      "name": "R",
      "type": "string",
      "label": "参照ファイルの範囲列名(必須)"
    },
    {
      "name": "rf",
      "type": "string",
      "label": "範囲比較を行う入力ファイル上の列名(必須)"
    },
    {
      "name": "k",
      "type": "string",
      "label": "入力データの結合キー名",
      "optional": true
    },
    {
      "name": "K",
      "type": "string",
      "label": "参照データの結合キー名",
      "optional": true
    },
    {
      "name": "f",
      "type": "string",
      "label": "参照ファイルの結合列",
      "optional": true
    },
    {
      "name": "n",
      "type": "boolean",
      "label": "参照データにない入力データを NULL 値として出力する",
      "optional": true
    },
    {
      "name": "N",
      "type": "boolean",
      "label": "入力データにない参照データを NULL 値として出力する",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目にNULL値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "入力項目のf=またはvf=で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      },
      {
        "name": "m",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "範囲による自然結合mnrjoin",
  "classification": "table_join",
  "description": "範囲により参照データの項目を結合する",
  "url": "./static/pdf/mcmd/table_join/mnrjoin.pdf"
}
