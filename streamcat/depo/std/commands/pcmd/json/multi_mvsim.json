    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "対象項目で指定された項目のNULL値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
