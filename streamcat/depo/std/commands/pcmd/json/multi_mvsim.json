{
  "id": "multi_mvsim",
  "groups": [
    {
      "name": "abstract",
      "label": "複数の移動窓の類似度の計算",
      "description": "複数の類似度を複数の期間に対して、算出する",
      "params": []
    },
    {
      "name": "grouping",
      "label": "グループの設定 (必須)",
      "params": [
        "k",
        "s"
      ]
    },
    {
      "name": "group3",
      "label": "移動窓と類似度計算の設定 (必須）",
      "description": "・類似度計算の設定を、対象項目1,2と類似度名で行う\n・移動窓は、期間数で幅を設定する",
      "params": [
        "fctlist",
        "a"
      ]
    },
    {
      "name": "group6",
      "label": "その他（省略可）",
      "params": [
        "nfn",
        "nfno",
        "x",
        "precision"
      ]
    },
    {
      "name": "group7",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "tmpPath",
        "assert_diffSize",
        "assert_nullkey",
        "assert_nullin",
        "assert_nullout"
      ]
    }
  ],
  "params": [
    {
      "name": "s",
      "type": "string",
      "label": "グループ内ソートの設定 (必須)",
      "description": "・ソートのキー項目を、カンマ区切りで複数指定可\n・ソートの種類は変更可能　(デフォルト: 文字列昇順)\n 　方法: 項目名末尾に記号を付与 (数値昇順：%n,  文字列降順： %r,  数値降順：%nr)\n・注意 グループ化する項目名と同じ項目名があると、不整合になり、ソートされません",
      "default": ""
    },
    {
      "name": "k",
      "type": "string",
      "label": "グループ化する項目名 (省略可)",
      "description": "・カンマ区切りで複数指定可\n・省略時は全ての行を同じグループとみなして処理される",
      "resizable": true
    },
    {
      "name": "a",
      "type": "string",
      "label": "結果の項目名の書式設定 (省略可)",
      "description": "・記号を組合せて書式を設定する\n・【記号】 &: 元の二つの項目名, %: 類似度名, #: 期間数",
      "default": "&_%_#"
    },
    {
      "name": "fctlist",
      "type": "list",
      "label": "移動窓と類似度計算の設定 (必須)",
      "description": "【対象項目1,2】 項目名を、それぞれ1つ指定可\n【類似度名】カンマ区切りで複数指定可\n【期間数】 カンマ区切りで複数指定可。1以上の整数で指定する",
      "elements": [
        {
          "name": "f1",
          "type": "string",
          "label": "対象項目1"
        },
        {
          "name": "f2",
          "type": "string",
          "label": "対象項目2"
        },
        {
          "name": "c",
          "type": "string",
          "label": "類似度名",
          "resizable": true
        },
        {
          "name": "t",
          "type": "string",
          "label": "期間数",
          "resizable": true
        }
      ],
      "default": [
        {
          "f1": "",
          "f2": "",
          "c": "",
          "t": "2"
        }
      ],
