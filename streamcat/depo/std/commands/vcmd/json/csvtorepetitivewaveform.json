{
    "version": "0.7.0",
    "id": "csvtorepetitiviewaveform",
    "order": 700,
    "label": "反復波形図",
    "classification": "visualize",
    "description": "csvファイルから反復波形図を作成する",
    "ports": [
      [
        {
          "label": "i",
          "type": "out"
        },
        {
          "label": "m",
          "type": "out"
        }
      ],
      [
        {
          "label": "o",
          "type": "out"
        }
      ]
    ],
    "params": [
      {
        "name": "offset",
        "type": "number",
        "label": "表示開始行"
      },
      {
        "name": "limit",
        "type": "number",
        "label": "表示行数",
        "default": 1000
      },
      {
        "name": "event_column",
        "label": "起点列",
        "type": "column",
        "options": {
          "multiple": false
        },
        "description": "各反復波形の時間軸の起点を指定n次の横軸列は、この起点からの経過時間を指定"
      },
      {
        "name": "x_axis",
        "type": "list",
        "elements": [
          {
            "name":"column",
            "type":"column",
            "label":"横軸列：時間軸"
          },
          {
            "name":"label",
            "type":"string",
            "label":"横軸名"
          }
        ],
        "default":[{"column":null, "label":""}],
        "options":{
          "visiable_button_add"  : false,
          "visiable_button_delete": false,
          "draggable" : false
        }
      },
      {
        "name": "y_axis",
        "type": "list",
        "elements": [
          {
            "name":"column",
            "type":"column",
            "label":"縦軸列：観測軸"
          },
          {
            "name":"label",
            "type":"string",
            "label":"縦軸名"
          }
        ],
        "default":[{"column":null, "label":""}],
        "options":{
          "visiable_button_add"  : false,
          "visiable_button_delete": false,
          "draggable" : false
        }
      },
      {
        "name": "data_column",
        "type": "column",
        "options":{
          "multiple": true
        },
        "label": "データ系列",
        "description": "データ系列を表す項目名（復数可、順序は指定不可）を指定します\n指定した項目の値（復数項目時はそれぞれの値の組合せ）を系列として設定します"
      },
      {
        "name": "group",
        "type": "column",
        "options":{
          "multiple": false
        },
        "label": "グループ化属性"
      },
      {
        "name": "marker",
        "type": "boolean",
        "label": "マーカーを表示する",
        "default":true
      },  
      {
        "name": "statics",
        "type": "boolean",
        "label": "統計量グラフを表示する",
        "default":true
      },  
      {
        "name": "event",
        "type": "boolean",
        "label": "起点を表示する",
        "default":true
      }, 
      {
        "name": "statics_type",
        "label": "表示する統計量",
        "type": "select",
        "options": {
          "multiple": false,
          "labels": ["最小・平均・最大で表示", "25％分位・中央値・75%分位で表示"],
          "values": ["min,mean,max", "qtile1,median,qtile3"]
        },
        "default": "min,mean,max"
      },
      {
        "name": "limit",
        "type": "number",
        "label": "表示の件数",
        "description": "件数分をデータから無作為に抽出します",
        "default": 1000
      }
    ],
    "groups": [
      {
        "name": "offset_group",
        "label": "データ表示範囲の設定",
        "params": ["offset","limit"]
      },
      {
        "name": "axis_group",
        "label": "軸の設定（必須）ラベルは省略可",
        "params": ["event_column","x_axis","y_axis"]
      },
      {
        "name": "graph_group",
        "label": "グラフ表示要素の設定",
        "params": ["marker","statics","event","statics_type"]
      },
      {
        "name": "data_group",
        "label": "データ系列の設定",
        "params": ["data_column","group"]
      }
    ],
    "url": ""
  }
  