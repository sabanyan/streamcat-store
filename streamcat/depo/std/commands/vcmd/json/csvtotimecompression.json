{
    "version": "0.7.0",
    "id": "csvtotimecompressionform",
    "order": 800,
    "label": "時間圧縮図",
    "classification": "visualize",
    "description": "csvファイルから時間圧縮図を作成する",
    "ports": [
      [
        {
          "label": "i",
          "type": "out"
        },
        {
          "label": "m",
          "type": "out"
        }
      ],
      [
        {
          "label": "o",
          "type": "out"
        }
      ]
    ],
    "params": [
      {
        "name": "offset",
        "type": "number",
        "label": "表示開始行"
      },
      {
        "name": "limit",
        "type": "number",
        "label": "表示行数",
        "default": 1000
      },
      {
        "name": "x_axis",
        "type": "list",
        "elements": [
          {
            "name":"column",
            "type":"column",
            "label":"横軸列：時間軸"
          },
          {
            "name":"label",
            "type":"string",
            "label":"横軸名"
          }
        ],
        "default":[{"column":null, "label":""}],
        "options":{
          "visiable_button_add"  : false,
          "visiable_button_delete": false,
          "draggable" : false
        }
      },
      {
        "name": "y_axis",
        "type": "list",
        "elements": [
          {
            "name":"column",
            "type":"column",
            "label":"縦軸列：観測値"
          },
          {
            "name":"label",
            "type":"string",
            "label":"縦軸名"
          }
        ],
        "default":[{"column":null, "label":""}],
        "options":{
          "visiable_button_add"  : false,
          "visiable_button_delete": false,
          "draggable" : false
        }
      },
      {
        "name": "data",
        "type": "column",
        "options":{
          "multiple": true
        },
        "label": "データ系列"
      },
      {
        "name": "division",
        "type": "number",
        "label": "期間の分割数",
        "default":100
      },
      {
        "name": "statics_type",
        "label": "表示する統計量",
        "type": "select",
        "options": {
          "multiple": false,
          "labels": ["最小・平均・最大で表示", "25％分位・中央値・75%分位で表示"],
          "values": ["min,mean,max", "qtile1,median,qtile3"]
        },
        "default": "min,mean,max"
      },
      {
        "name": "display_pattern",
        "label": "塗り潰し",
        "type": "select",
        "options": {
          "multiple": false,
          "labels": ["線", "ハッチ掛け"],
          "values": ["line", "hatch"]
        },
        "default": "line"
      },
      {
        "name": "limit",
        "type": "number",
        "label": "表示の件数",
        "description": "件数分をデータから無作為に抽出します",
        "default": 1000
      }
    ],
    "groups": [
      {
        "name": "offset_group",
        "label": "データ表示範囲の設定",
        "params": ["offset","limit"]
      },
      {
        "name": "axis_group",
        "label": "軸の設定（必須）ラベルは省略可",
        "params": ["x_axis","y_axis"]
      },
      {
        "name": "graph_group",
        "label": "グラフ表示要素の設定",
        "params": ["division","statics_type","display_pattern"]
      },
      {
        "name": "data_group",
        "label": "データ系列の設定",
        "params": ["data"]
      }
    ],
    "url": ""
  }
  