{
  "id": "mdformat",
  "groups": [
    {
      "name": "group0",
      "label": "日付時刻要素の抽出",
      "description": "日付要素が含まれた文字列から、各要素を抽出して、既定の日付型、時刻型に変換する",
      "params": []
    },
    {
      "name": "group5",
      "label": "日付要素抽出の設定 (必須)",
      "params": [
        "c",
        "f",
        "A"
      ]
    },
    {
      "name": "cmd_sub",
      "label": "その他（省略可）",
      "params": [
        "nfn",
        "nfno",
        "x"
      ]
    },
    {
      "name": "group20",
      "label": "システム管理用設定（作業領域・ログ出力）",
      "params": [
        "assert_diffSize",
        "assert_nullin",
        "assert_nullout",
        "tmpPath"
      ]
    }
  ],
  "params": [
    {
      "name": "c",
      "type": "string",
      "label": "日付時刻書式の指定 (必須)",
      "resizable": true,
      "description": "・対象項目の日付時刻要素を、プレースホルダで置き換えた文字列を指定する",
      "helper": {
        "c": {
          "label": "日付時刻指定",
          "tabs": [
            {
              "label": "日付時刻要素の指定",
              "data": [
                {
                  "label": "プレースホルダ記号",
                  "shortcuts": [
                    {
                      "value": "%Y",
                      "label": "年 (西暦4桁以内)",
                      "link": "%Y",
                      "delimiter": ""
                    },
                    {
                      "value": "%y",
                      "label": "年 (西暦2桁以内)",
                      "link": "%y",
                      "delimiter": ""
                    },
                    {
                      "value": "%m",
                      "label": "月 (2桁以内)",
                      "link": "%m",
                      "delimiter": ""
                    },
                    {
                      "value": "%d",
                      "label": "日 (2桁以内)",
                      "link": "%d",
                      "delimiter": ""
                    },
                    {
                      "value": "%H",
                      "label": "時 (24時間表記で2桁以内)",
                      "link": "%H",
                      "delimiter": ""
                    },
                    {
                      "value": "%M",
                      "label": "分 (2桁以内)",
                      "link": "%M",
                      "delimiter": ""
                    },
                    {
                      "value": "%S",
                      "label": "秒 (2桁以内)",
                      "link": "%S",
                      "delimiter": ""
                    },
                    {
                      "value": "%s",
                      "label": "秒と秒以下 (秒以下6桁以内)",
                      "link": "%s",
                      "delimiter": ""
                    },
                    {
                      "value": "",
                      "label": "  ※秒と秒以下の区切り文字はピリオド",
                      "link": "",
                      "delimiter": ""
                    }
                  ]
                },
                {
                  "label": "指定の例",
                  "shortcuts": [
                    {
                      "value": "%Y-%m-%d %H:%M:%S",
                      "label": "yyyy-mm-dd HH:MM:SS",
                      "link": "%Y-%m-%d %H:%M:%S",
                      "delimiter": ""
                    },
                    {
                      "value": "%Y%m%d %H%M%S",
                      "label": "yyyymmdd HHMMSS",
                      "link": "%Y%m%d %H%M%S",
                      "delimiter": ""
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "f",
      "type": "string",
      "label": "対象とする項目名 (必須)",
      "description": "・カンマ区切りで複数指定可\n・ワイルドカード(*,？ )使用可",
      "resizable": true
    },
    {
      "name": "A",
      "type": "boolean",
      "label": "置換ではなく、項目を追加して出力する",
      "description": "追加する項目名は、対象とする項目名の後に、:区切りで入力する",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullin",
      "type": "boolean",
      "label": "対象とする項目名で指定された項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "assert_nullout",
      "type": "boolean",
      "label": "出力項目の NULL 値チェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの 1 行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目名ではなく、項目番号で指定する",
      "optional": true,
      "description": "・0始まりの項目番号で指定する\n・Lをつけると、右端起点の項目番号とみなす(例:3L)\n・複数入力可能なOptの場合は、列範囲としての指定も可能(例: 0-5)"
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "日付時刻要素の抽出",
  "classification": "value_transform",
  "description": "指定したフォーマットで年月日・時分秒を抽出する",
  "url": "./static/pdf/mcmd/value_transform/mdformat.pdf"
}